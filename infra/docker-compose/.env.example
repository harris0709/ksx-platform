# =====================================================================
# ksx-platform S0 환경변수 템플릿
#   ../scripts/gen-secrets.sh 가 이 파일을 복사해 .env 를 만들고
#   CHANGE_ME 값을 무작위 비밀번호로 채운다.  .env 는 절대 커밋하지 않는다.
#   운영(Helm)에서는 같은 키를 Kubernetes Secret/Vault 에서 주입한다.
# =====================================================================

# ---- 이미지 버전 (착수 시 최신 안정 버전 확인 후 고정, 전 환경 동일) ----
AGE_IMAGE_TAG=release_PG16_1.5.0
KAFKA_VERSION=3.9.0
AIRFLOW_VERSION=2.10.5
JENA_VERSION=5.2.0
ONTOP_VERSION=5.2.1
PG_JDBC_VERSION=42.7.4
QDRANT_VERSION=v1.13.0
KEYCLOAK_VERSION=26.1.0
OPA_VERSION=1.0.0

# ---- PostgreSQL ----
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
KSX_OWNER_PASSWORD=CHANGE_ME      # 스키마 소유자(DDL, S3 마이그레이션)
KSX_LOADER_PASSWORD=CHANGE_ME     # dbt·Airflow 적재(stg/ksx/ext 쓰기)
KSX_READER_PASSWORD=CHANGE_ME     # Ontop·MCP 도구(읽기 전용, RLS 적용)
KSX_BOD_PASSWORD=CHANGE_ME        # BOD Gateway(런타임 원장 쓰기 유일 계정)
KSX_AUDIT_PASSWORD=CHANGE_ME      # 실행·적재 기록(audit 쓰기)
AIRFLOW_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# ---- Airflow ----
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_FERNET_KEY=CHANGE_ME_FERNET
AIRFLOW_SECRET_KEY=CHANGE_ME

# ---- Qdrant ----
QDRANT_API_KEY=CHANGE_ME

# ---- Keycloak ----
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KSX_MCP_CLIENT_SECRET=CHANGE_ME   # MCP 도구 서버 client secret
KSX_BOD_CLIENT_SECRET=CHANGE_ME   # BOD Gateway client secret
KSX_DEV_USER_PASSWORD=CHANGE_ME   # 개발 사용자 dev-* 공통 비밀번호(운영 realm에는 사용자 import 안 함)

# ---- Ontop: S0~S3는 bootstrap, S4 이후 생성물로 교체 ----
ONTOP_ONTOLOGY_FILE=/opt/bootstrap/bootstrap.ttl
ONTOP_MAPPING_FILE=/opt/bootstrap/bootstrap.obda
# ONTOP_ONTOLOGY_FILE=/opt/onto/tbox/ksx9101_core.ttl
# ONTOP_MAPPING_FILE=/opt/onto/mappings/ksx9101.obda

# ---- [S1~S3 실습] IMPIX 가상 원천 시스템(profile: sim) ----
IMPIX_SRC_ADMIN_PASSWORD=CHANGE_ME
IMPIX_SRC_READER_PASSWORD=CHANGE_ME   # 원천 분석 계정 s1_reader
