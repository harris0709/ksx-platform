PREFIX ksx: <https://ontology.impix.co.kr/ksx9101/1.0/>
PREFIX inf: <https://ontology.impix.co.kr/inference/>
PREFIX ksxq: <https://ontology.impix.co.kr/quality/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# <ID> <이름>(<유형: 전이·체인·이벤트·업무 규칙>): <경로> ⇒ <결과>. <업무 질의 ID>, <사건>
#   양식 — 복사: mapping/_template/rule_양식.rq → ontologies/rules/<ID>_<영문 소문자 이름>.rq
#   ID 체계(rules/README.md): R-001~009 구조·계보, R-010~019 영향 전개, R-020~029 이상·품질 이벤트,
#     R-030~039 상태 기반 영향, R-100~199 업무 판단·리스크 이벤트. 앞 규칙 결과를 쓰면 더 큰 번호.
#   지킬 것
#     - 원천이 실제로 채운 길로 쓴다(답의 위치를 원천에서 먼저 확인 — s7_answers.sql)
#     - 결과 주어(필요하면 경유 개체도)의 위반 표식 제외: FILTER NOT EXISTS { ?x ksxq:violates ?v }
#     - 임계값·기간은 ${이름}(rules/params.yaml), 기준일 ${today}, 날짜 연산 결과는 실행기가 넣는 값(${due_limit})
#     - 이벤트는 결정적 IRI + inf:ruleId "<ID>", 원인이 여럿이면 원인 노드로 짝짓기
#     - 새 inf: 어휘는 ontologies/inference/inf.ttl에 선언(회귀 시험이 확인), rules/README.md 목록 갱신
#     - 평가 사례를 s7_plan.yaml evaluate.cases에 추가

# 예 1) 체인 — 관계 하나를 이끌어 낸다
CONSTRUCT { ?po inf:hasHeldLot ?lot }
WHERE {
  ?lot a ksx:Lot ; ksx:holdIndicator true ; ksx:refProductionOrder ?po .
  FILTER NOT EXISTS { ?lot ksxq:violates ?v }
}

# 예 2) 이벤트 — 조건을 판단해 이벤트 노드를 만든다(파일 하나에 CONSTRUCT 하나만 둔다)
# CONSTRUCT {
#   ?evt a inf:<이름>Event ; inf:on<대상> ?x ; inf:<값> ?val ; inf:ruleId "<ID>" .
# }
# WHERE {
#   ?x a ksx:<클래스> ; ksx:<속성> ?val .
#   FILTER (?val > ${<파라미터>})
#   FILTER NOT EXISTS { ?x ksxq:violates ?v }
#   BIND (IRI(CONCAT(STR(?x), "/<이름>/<ID>")) AS ?evt)
# }
