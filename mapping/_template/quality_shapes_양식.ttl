# <기업> 품질 셰이프(저작) — 양식 (구현안내서 9.1, 표 24 4차원)
#   복사: mapping/_template/quality_shapes_양식.ttl → ontologies/quality/<기업 소문자>_quality.ttl
#   적합성 셰이프(ontologies/shapes, S4 생성물)는 표준 규정(필수·카디널리티·타입·코드·참조)을 맡는다 — 기업 사정으로 완화하지 않는다.
#   이 파일은 표준에 없는 현장 품질 규칙을 맡는다. ksxkg validate가 두 셰이프를 함께 실행한다.
#
#   셰이프마다 지킬 것
#     ksxq:ruleId    승인기록·리포트 대응(Q-01 …)
#     ksxq:dimension 구조 | 값 | 관계 | 의미 — 리포트 집계 차원
#     ksxq:owner     위반 알림 대상(S1 인벤토리의 원천 시스템·테이블·책임자)
#     sh:severity    셰이프(NodeShape)에 적는다 — Jena는 SPARQL 제약 노드의 sh:severity를 무시한다
#                    sh:Violation: ksxq:violates 표식 → S7 추론에서 제외 / sh:Warning: 리포트·알림만
#     ?value         SELECT에 두면 리포트의 "값" 열에 나온다(어긋난 일시·품목 등)
#     {{이름}}       기업 운영 방식(공장·라인 목록 등)은 값 대신 자리만 둔다 — s6_plan.yaml validate.params에 값과 근거
@prefix ksx:  <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix ksxq: <https://ontology.impix.co.kr/quality/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

ksxq:prefixes a owl:Ontology ;
    sh:declare [ sh:prefix "ksx" ; sh:namespace "https://ontology.impix.co.kr/ksx9101/1.0/"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

# Q-01 의미(위반): <규칙 한 줄 — 예: 생산실적 종료 일시는 시작 일시 이후> (<근거: S1 시나리오·S3 정제 규칙 번호>)
ksxq:Q01_PerformanceEndAfterStart a sh:NodeShape ;
    rdfs:label "Q-01 생산실적 종료 ≥ 시작"@ko ;
    ksxq:ruleId "Q-01" ; ksxq:dimension "의미" ; ksxq:owner "<원천 시스템(테이블)>" ;
    sh:targetClass ksx:ProductionPerformance ;
    sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "생산실적 종료 일시가 시작 일시보다 이릅니다" ;
        sh:prefixes ksxq:prefixes ;
        sh:select """SELECT $this ?value WHERE {
            $this ksx:executionStartDateTime ?b ; ksx:executionEndDateTime ?value .
            FILTER (?value < ?b) }""" ] .

# Q-02 의미(경고, 매개변수): <규칙 — 예: 지시 기반 공장의 LOT은 생산지시 등록 뒤에 생성>. 대상 공장은 계획 params.order_driven_plants
ksxq:Q02_LotAfterOrder a sh:NodeShape ;
    rdfs:label "Q-02 LOT 생성 ≥ 생산지시 등록"@ko ;
    ksxq:ruleId "Q-02" ; ksxq:dimension "의미" ; ksxq:owner "<원천 시스템(테이블)>" ;
    sh:targetClass ksx:Lot ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "LOT이 연결된 생산지시의 등록 시각보다 먼저 생성되었습니다" ;
        sh:prefixes ksxq:prefixes ;
        sh:select """SELECT $this ?value WHERE {
            $this ksx:plantID ?plant ; ksx:creationDateTime ?c ; ksx:refProductionOrder ?value .
            VALUES ?plant { {{order_driven_plants}} }
            ?value ksx:creationDateTime ?o .
            FILTER (?c < ?o) }""" ] .

# Q-03 관계(위반): <규칙 — 예: 생산실적의 품목은 실적 LOT의 품목과 같다>
ksxq:Q03_PerformanceItemMatchesLot a sh:NodeShape ;
    rdfs:label "Q-03 실적 품목 = LOT 품목"@ko ;
    ksxq:ruleId "Q-03" ; ksxq:dimension "관계" ; ksxq:owner "<원천 시스템(테이블)>" ;
    sh:targetClass ksx:ProductionPerformance ;
    sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "생산실적의 품목이 실적 LOT의 품목과 다릅니다" ;
        sh:prefixes ksxq:prefixes ;
        sh:select """SELECT $this ?value WHERE {
            $this ksx:refLot ?lot ; ksx:refItem ?value .
            ?lot ksx:refItem ?li .
            FILTER (?value != ?li) }""" ] .

# Q-04 구조(위반): <규칙 — 예: 설비 파라미터 이력은 발생 일시와 값을 가진다>
ksxq:Q04_TraceParameterEvent a sh:NodeShape ;
    rdfs:label "Q-04 파라미터 이벤트 필수 값"@ko ;
    ksxq:ruleId "Q-04" ; ksxq:dimension "구조" ; ksxq:owner "<원천 시스템(테이블)>" ;
    sh:targetClass ksx:TraceParameter ;
    sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "설비 파라미터 이력에 발생 일시 또는 값이 없습니다" ;
        sh:prefixes ksxq:prefixes ;
        sh:select """SELECT $this WHERE {
            FILTER (NOT EXISTS { $this ksx:eventDateTime ?t } || NOT EXISTS { $this ksx:parameterValue ?v }) }""" ] .

# Q-05 값(위반): <규칙 — 예: 생산지시 수량에는 단위가 있다>
ksxq:Q05_OrderQuantityHasUnit a sh:NodeShape ;
    rdfs:label "Q-05 지시 수량 단위"@ko ;
    ksxq:ruleId "Q-05" ; ksxq:dimension "값" ; ksxq:owner "<원천 시스템(테이블)>" ;
    sh:targetClass ksx:ProductionOrder ;
    sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "생산지시 수량에 단위가 없습니다" ;
        sh:prefixes ksxq:prefixes ;
        sh:select """SELECT $this ?value WHERE {
            $this ksx:productionOrderQuantity ?value .
            FILTER NOT EXISTS { $this ksx:itemUOMCode ?u } }""" ] .
