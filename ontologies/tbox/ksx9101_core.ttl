@prefix ksx:  <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<https://ontology.impix.co.kr/ksx9101/1.0> a owl:Ontology ;
    rdfs:label "KS X 9101-1 제조 온톨로지 Core"@ko ;
    owl:versionInfo "KS X 9101-1:2025 개정안 v1.0" ;
    dct:source "KSX9101-1_v1.0_테이블정의서.xlsx" .

### 메타 클래스·주석 속성
ksx:Noun a owl:Class ; rdfs:label "KS X 9101 명사"@ko .
ksx:StructLine a owl:Class ; rdfs:label "라인 구조체(struct[1..N])"@ko ; rdfs:comment "명사 안에서만 존재하는 반복 행. 독립 명사가 아님"@ko .
ksx:standardClause a owl:AnnotationProperty .
ksx:standardTable a owl:AnnotationProperty .
ksx:businessArea a owl:AnnotationProperty .
ksx:sourceAttribute a owl:AnnotationProperty .
ksx:copyOf a owl:AnnotationProperty ; rdfs:comment "사본 속성의 원천(Noun.Attr). 관계가 아님"@ko .
ksx:codeGroup a owl:AnnotationProperty .
ksx:structOf a owl:AnnotationProperty .
ksx:structType a owl:AnnotationProperty .
ksx:physicalTable a owl:AnnotationProperty .
ksx:conversionFactor a owl:DatatypeProperty ; rdfs:label "기준단위 환산계수"@ko ; rdfs:range xsd:decimal .
ksx:hasLine a owl:ObjectProperty ; rdfs:label "라인"@ko ; rdfs:range ksx:StructLine ; owl:inverseOf ksx:lineOf .
ksx:lineOf a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "소속 헤더"@ko .

### 클래스(명사·라인 구조체)
ksx:Site a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "사업장"@ko, "Site"@en ;
    skos:definition "회사 내 하위 관리단위로서의 사업장을 의미한다."@ko ;
    ksx:standardClause "7.4.1.1" ; ksx:standardTable "표 12" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "Site" .
ksx:Plant a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "공장"@ko, "Plant"@en ;
    skos:definition "회사 내 하위 관리단위로서의 공장을 의미한다."@ko ;
    ksx:standardClause "7.4.1.2" ; ksx:standardTable "표 13" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "Plant" .
ksx:Department a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "부서"@ko, "Department"@en ;
    skos:definition "회사 내 하위 관리 단위로서의 부서를 의미한다."@ko ;
    ksx:standardClause "7.4.1.3" ; ksx:standardTable "표 14" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "Department" .
ksx:Personnel a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "사원"@ko, "Personnel"@en ;
    skos:definition "사원코드, 사원명, 인적정보 등을 관리하는 사원 마스터를 의미한다. 일반적으로 HRMS(Human Resource Management System)에서 사용되지만 작업 스케줄링 또는 자원 할당에서 사용될 수도 있다."@ko ;
    ksx:standardClause "7.4.1.4" ; ksx:standardTable "표 15" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "Personnel" .
ksx:CustomerPartyMaster a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "고객사"@ko, "CustomerPartyMaster"@en ;
    skos:definition "고객사 코드, 고객사명, 사업자등록번호 등 고객사 정보를 관리하는 고객사 마스터를 의미한다."@ko ;
    ksx:standardClause "7.4.1.5" ; ksx:standardTable "표 16" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "CustomerPartyMaster" .
ksx:VendorPartyMaster a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "공급사"@ko, "VendorPartyMaster"@en ;
    skos:definition "공급사 코드, 공급사명, 사업자등록번호 등 공급사 정보를 관리하는 공급사 마스터를 의미한다."@ko ;
    ksx:standardClause "7.4.1.6" ; ksx:standardTable "표 17" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "VendorPartyMaster" .
ksx:CommonCodeMaster a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "공통코드정보"@ko, "CommonCodeMaster"@en ;
    skos:definition "애플리케이션 내에서 사용되는 각종 코드를 모아 놓은 통합 코드를 의미한다."@ko ;
    ksx:standardClause "7.4.1.7" ; ksx:standardTable "표 18" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "CommonCodeMaster" .
ksx:WorkCalendar a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "달력"@ko, "WorkCalendar"@en ;
    skos:definition "생산 현장의 달력을 의미한다. 단, 인사에서 사용하는 일반 달력과는 차이가 있다."@ko ;
    ksx:standardClause "7.4.1.8" ; ksx:standardTable "표 19" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "WorkCalendar" .
ksx:UOMGroup a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "단위그룹"@ko, "UOMGroup"@en ;
    skos:definition "단위그룹(UOMGroup) 명사의 헤더 구조체(struct) 단위그룹 1건의 공통 정보(중량, 부피, 길이 등 측정 단위의 그룹) 단위그룹마다 1회 나타남"@ko ;
    ksx:standardClause "7.4.1.9" ; ksx:standardTable "표 20" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "UOMGroupHeader" .
ksx:UOMGroupLine a owl:Class ; rdfs:subClassOf ksx:StructLine ;
    rdfs:label "단위그룹라인"@ko, "UOMGroupLine"@en ;
    ksx:structOf ksx:UOMGroup ; ksx:structType "struct[1..N]" ;
    ksx:physicalTable "UOMGroupLine" ; ksx:standardClause "7.4.1.9" .
ksx:ItemMaster a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "품목마스터"@ko, "ItemMaster"@en ;
    skos:definition "품목코드, 품목명, 규격 등과 각종 속성값을 관리하는 품목마스터를 의미한다. 단, 수량정보는 포함하지 않는다."@ko ;
    ksx:standardClause "7.4.1.10" ; ksx:standardTable "표 21" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "ItemMaster" .
ksx:BOM a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "자재명세서"@ko, "BOM"@en ;
    skos:definition "자재명세서(BOM) 명사의 헤더 구조체(struct) 자재명세서 1건의 공통 정보(모품목, 버전, 유형, 공정경로) 자재명세서마다 1회 나타남"@ko ;
    ksx:standardClause "7.4.1.11" ; ksx:standardTable "표 22" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "BOMHeader" .
ksx:BOMLine a owl:Class ; rdfs:subClassOf ksx:StructLine ;
    rdfs:label "자재명세서라인"@ko, "BOMLine"@en ;
    ksx:structOf ksx:BOM ; ksx:structType "struct[1..N]" ;
    ksx:physicalTable "BOMLine" ; ksx:standardClause "7.4.1.11" .
ksx:Lot a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "로트"@ko, "Lot"@en ;
    skos:definition "묶음 생산 단위의 정보를 의미한다."@ko ;
    ksx:standardClause "7.4.1.12" ; ksx:standardTable "표 23" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "Lot" .
ksx:Routing a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "공정경로"@ko, "Routing"@en ;
    skos:definition "공정경로(Routing) 명사의 헤더 구조체(struct) 공정경로 1건의 공통 정보(공정경로명, 대상 품목, 사용 여부) 공정경로마다 1회 나타남"@ko ;
    ksx:standardClause "7.4.1.13" ; ksx:standardTable "표 24" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "RoutingHeader" .
ksx:RoutingLine a owl:Class ; rdfs:subClassOf ksx:StructLine ;
    rdfs:label "공정경로라인"@ko, "RoutingLine"@en ;
    ksx:structOf ksx:Routing ; ksx:structType "struct[1..N]" ;
    ksx:physicalTable "RoutingLine" ; ksx:standardClause "7.4.1.13" .
ksx:Operation a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "공정"@ko, "Operation"@en ;
    skos:definition "생산작업을 수행하는 작업장 또는 작업장 내 세부 작업단위를 의미한다."@ko ;
    ksx:standardClause "7.4.1.14" ; ksx:standardTable "표 25" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "Operation" .
ksx:Equipment a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "설비"@ko, "Equipment"@en ;
    skos:definition "설비명, 설비유형 등 설비 관리 및 회사의 자산으로서 관리를 위한 설비정보를 의미한다."@ko ;
    ksx:standardClause "7.4.1.15" ; ksx:standardTable "표 26" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "Equipment" .
ksx:OperationEquipment a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "공정설비"@ko, "OperationEquipment"@en ;
    skos:definition "공정별 사용되는 설비 정보 데이터를 의미한다."@ko ;
    ksx:standardClause "7.4.1.16" ; ksx:standardTable "표 27" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "OperationEquipment" .
ksx:Carrier a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "캐리어"@ko, "Carrier"@en ;
    skos:definition "제조 공정 내 이동에 필요한 물리적 용기를 의미한다."@ko ;
    ksx:standardClause "7.4.1.17" ; ksx:standardTable "표 28" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "Carrier" .
ksx:StockerInventory a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "저장소재공정보"@ko, "StockerInventory"@en ;
    skos:definition "공장 내 공정 물류 저장소 정보를 의미한다. 이는 공정 내 물류 최적화를 위해 Lot Dispatcher를 사용하는데 SCS(StockerControlSystem), Dispatcher, MES 상호연동을 위해 존재한다."@ko ;
    ksx:standardClause "7.4.1.18" ; ksx:standardTable "표 29" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "StockerInventory" .
ksx:WarehouseLocation a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "창고"@ko, "WarehouseLocation"@en ;
    skos:definition "창고(WarehouseLocation) 명사의 헤더 구조체(struct) 창고 1건의 공통 정보(창고명, 창고유형, 재고 관리 기준) 창고마다 1회 나타남"@ko ;
    ksx:standardClause "7.4.1.19" ; ksx:standardTable "표 30" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "WarehouseLocationHeader" .
ksx:WarehouseLocationLine a owl:Class ; rdfs:subClassOf ksx:StructLine ;
    rdfs:label "창고라인"@ko, "WarehouseLocationLine"@en ;
    ksx:structOf ksx:WarehouseLocation ; ksx:structType "struct[1..N]" ;
    ksx:physicalTable "WarehouseLocationLine" ; ksx:standardClause "7.4.1.19" .
ksx:Batch a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "배치"@ko, "Batch"@en ;
    skos:definition "배치 공정의 1회 실행으로 생산되고 있거나 생산된 물질의 단위를 의미한다. 원료를 정해진 양만큼 투입하여 일괄 처리하는 공정(배합, 반응, 발효, 열처리 등)의 생산 단위이며, 공급사에서 생산하여 납품한 구매품의 배치를 포함한다."@ko ;
    ksx:standardClause "7.4.1.20" ; ksx:standardTable "표 31" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "Batch" .
ksx:Line a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "라인"@ko, "Line"@en ;
    skos:definition "같은 공장 안에서 공정과 설비를 일정한 흐름으로 배치하여 특정 품목 또는 품목군을 생산하는 생산 단위를 의미한다. 라인은 공장에 속하며, 하나 이상의 공정과 설비로 구성된다."@ko ;
    ksx:standardClause "7.4.1.21" ; ksx:standardTable "표 32" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "Line" .
ksx:Enterprise a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "회사"@ko, "Enterprise"@en ;
    skos:definition "기업업무시스템 간 제조업무데이터를 교환하는 법인 단위의 회사를 의미한다. 회사는 하나 이상의 사업장으로 구성되며, 모든 명사 정보의 최상위 소유 범위가 된다."@ko ;
    ksx:standardClause "7.4.1.22" ; ksx:standardTable "표 33" ;
    ksx:businessArea "기준정보"@ko ; ksx:physicalTable "Enterprise" .
ksx:ProjectMaster a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "프로젝트마스터"@ko, "ProjectMaster"@en ;
    skos:definition "프로젝트 코드, 프로젝트명 등을 관리하는 프로젝트마스터를 의미한다. 주요 프로젝트 필드의 ProjectAccounting 관련 애플리케이션 활성화를 위한정보로 활용되기도 한다."@ko ;
    ksx:standardClause "7.4.2.1" ; ksx:standardTable "표 34" ;
    ksx:businessArea "프로젝트관리"@ko ; ksx:physicalTable "ProjectMaster" .
ksx:EngineeringChangeOrder a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "설계변경지시"@ko, "EngineeringChangeOrder"@en ;
    skos:definition "제품의 설계를 변경하는 지시를 의미한다. 설계변경지시 수행 결과는 BOM 및 공정경로BOM에 반영된다."@ko ;
    ksx:standardClause "7.4.2.2" ; ksx:standardTable "표 35" ;
    ksx:businessArea "프로젝트관리"@ko ; ksx:physicalTable "EngineeringChangeOrder" .
ksx:SalesOrder a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "수주오더"@ko, "SalesOrder"@en ;
    skos:definition "수주오더(SalesOrder) 명사의 헤더 구조체(struct) 수주문서 1건의 공통 정보(고객사, 수주일, 수주유형, 거래 조건) 수주문서마다 1회 나타남"@ko ;
    ksx:standardClause "7.4.3.1" ; ksx:standardTable "표 36" ;
    ksx:businessArea "판매관리"@ko ; ksx:physicalTable "SalesOrderHeader" .
ksx:SalesOrderLine a owl:Class ; rdfs:subClassOf ksx:StructLine ;
    rdfs:label "수주오더라인"@ko, "SalesOrderLine"@en ;
    ksx:structOf ksx:SalesOrder ; ksx:structType "struct[1..N]" ;
    ksx:physicalTable "SalesOrderLine" ; ksx:standardClause "7.4.3.1" .
ksx:SalesPlan a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "판매계획"@ko, "SalesPlan"@en ;
    skos:definition "고객사 Forecast정보 및 수요예측정보를 토대로 작성된 판매계획을 의미한다."@ko ;
    ksx:standardClause "7.4.3.2" ; ksx:standardTable "표 37" ;
    ksx:businessArea "판매관리"@ko ; ksx:physicalTable "SalesPlan" .
ksx:BasePrice a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "기준가격"@ko, "BasePrice"@en ;
    skos:definition "구매요청 시 참조하기 위한 구매품의 기준가격 정보를 의미한다."@ko ;
    ksx:standardClause "7.4.4.1" ; ksx:standardTable "표 38" ;
    ksx:businessArea "구매관리"@ko ; ksx:physicalTable "BasePrice" .
ksx:PurchaseRequisition a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "구매요청"@ko, "PurchaseRequisition"@en ;
    skos:definition "생산 또는 판매를 위해 수급되어야 할 품목을 요청하는 것을 의미한다(원부자재, 소모품, 상품 등)."@ko ;
    ksx:standardClause "7.4.4.2" ; ksx:standardTable "표 39" ;
    ksx:businessArea "구매관리"@ko ; ksx:physicalTable "PurchaseRequisition" .
ksx:PurchaseOrder a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "구매발주"@ko, "PurchaseOrder"@en ;
    skos:definition "구매발주(PurchaseOrder) 명사의 헤더 구조체(struct) 구매문서 1건의 공통 정보(공급사, 발주일, 결제·거래 조건, 담당자) 구매문서마다 1회 나타남"@ko ;
    ksx:standardClause "7.4.4.3" ; ksx:standardTable "표 40" ;
    ksx:businessArea "구매관리"@ko ; ksx:physicalTable "PurchaseOrderHeader" .
ksx:PurchaseOrderLine a owl:Class ; rdfs:subClassOf ksx:StructLine ;
    rdfs:label "구매발주라인"@ko, "PurchaseOrderLine"@en ;
    ksx:structOf ksx:PurchaseOrder ; ksx:structType "struct[1..N]" ;
    ksx:physicalTable "PurchaseOrderLine" ; ksx:standardClause "7.4.4.3" .
ksx:MaterialArrival a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "자재도착"@ko, "MaterialArrival"@en ;
    skos:definition "자재가 입고 전 수입검사를 위해 도착한 정보를 의미한다."@ko ;
    ksx:standardClause "7.4.5.1" ; ksx:standardTable "표 41" ;
    ksx:businessArea "자재관리"@ko ; ksx:physicalTable "MaterialArrival" .
ksx:GoodsReceipt a owl:Class ; rdfs:subClassOf ksx:Noun ;
    rdfs:label "입고"@ko, "GoodsReceipt"@en ;
