    sh:property [ sh:path impix:occurrenceDate ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path impix:complaintReceiptDate ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
