    sh:property [ sh:path impix:complaintAmount ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ksx:currencyCode ; sh:maxCount 1 ; sh:class skos:Concept ] ;
    sh:property [ sh:path impix:causeOperationID ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path impix:complaintDescription ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ksx:refEnterprise ; sh:class ksx:Enterprise ; sh:minCount 1 ] ;
    sh:property [ sh:path ksx:refSite ; sh:class ksx:Site ; sh:minCount 1 ] ;
    sh:property [ sh:path ksx:refPlant ; sh:class ksx:Plant ; sh:minCount 1 ] ;
    sh:property [ sh:path ksx:refCreator ; sh:class ksx:Personnel ] ;
    sh:property [ sh:path ksx:refModifier ; sh:class ksx:Personnel ] ;
    sh:property [ sh:path ksx:refCustomer ; sh:class ksx:CustomerPartyMaster ; sh:minCount 1 ] ;
    sh:property [ sh:path ksx:refItem ; sh:class ksx:ItemMaster ] ;
    sh:property [ sh:path ksx:refLot ; sh:class ksx:Lot ] ;
    sh:property [ sh:path impix:refCauseOperation ; sh:class ksx:Operation ] .

