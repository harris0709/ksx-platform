@prefix ksx:  <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix impix: <https://ontology.impix.co.kr/ext/impix/1.0/> .

@prefix impixs: <https://ontology.impix.co.kr/ext/impix/1.0/shapes/> .

impixs:StandardCostShape a sh:NodeShape ; sh:targetClass impix:StandardCost ;
    sh:property [ sh:path ksx:enterpriseID ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ksx:siteID ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ksx:plantID ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ksx:creatorID ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ksx:creationDateTime ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path ksx:modifierID ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ksx:modificationDateTime ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path ksx:note ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path impix:standardCostID ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ksx:itemID ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ksx:operationID ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path impix:costPeriodStartDate ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path impix:costPeriodEndDate ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path impix:standardCostAmount ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path impix:materialCostAmount ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path impix:laborCostAmount ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path impix:overheadCostAmount ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ksx:currencyCode ; sh:maxCount 1 ; sh:class skos:Concept ] ;
    sh:property [ sh:path ksx:itemUOMCode ; sh:maxCount 1 ; sh:class skos:Concept ] ;
    sh:property [ sh:path ksx:refEnterprise ; sh:class ksx:Enterprise ; sh:minCount 1 ] ;
    sh:property [ sh:path ksx:refSite ; sh:class ksx:Site ; sh:minCount 1 ] ;
    sh:property [ sh:path ksx:refPlant ; sh:class ksx:Plant ; sh:minCount 1 ] ;
    sh:property [ sh:path ksx:refCreator ; sh:class ksx:Personnel ] ;
    sh:property [ sh:path ksx:refModifier ; sh:class ksx:Personnel ] ;
    sh:property [ sh:path ksx:refItem ; sh:class ksx:ItemMaster ; sh:minCount 1 ] ;
    sh:property [ sh:path ksx:refOperation ; sh:class ksx:Operation ] .

impixs:CustomerComplaintShape a sh:NodeShape ; sh:targetClass impix:CustomerComplaint ;
    sh:property [ sh:path ksx:enterpriseID ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ] ;
