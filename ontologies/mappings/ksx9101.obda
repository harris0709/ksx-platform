[PrefixDeclaration]
ksx:	https://ontology.impix.co.kr/ksx9101/1.0/
d:	https://data.impix.co.kr/
xsd:	http://www.w3.org/2001/XMLSchema#
skos:	http://www.w3.org/2004/02/skos/core#

[MappingDeclaration] @collection [[
mappingId	Site
target		d:{enterpriseid}/Site/{siteid} a ksx:Site ; ksx:enterpriseID {enterpriseid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:siteID {siteid} ; ksx:siteName {sitename} ; ksx:businessRegistrationNumber {businessregistrationnumber} ; ksx:dialNumber {dialnumber} ; ksx:postalCode {postalcode} ; ksx:baseAddress {baseaddress} ; ksx:detailAddress {detailaddress} ; ksx:useIndicator {useindicator}^^xsd:boolean ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} .
source		SELECT "EnterpriseID" AS enterpriseid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "SiteID" AS siteid, "SiteName" AS sitename, "BusinessRegistrationNumber" AS businessregistrationnumber, "DialNumber" AS dialnumber, "PostalCode" AS postalcode, "BaseAddress" AS baseaddress, "DetailAddress" AS detailaddress, "UseIndicator" AS useindicator FROM ksx."Site"

mappingId	Plant
target		d:{enterpriseid}/Plant/{plantid} a ksx:Plant ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:plantID {plantid} ; ksx:plantName {plantname} ; ksx:dialNumber {dialnumber} ; ksx:countryID d:codelist/CountryID/{countryid} ; ksx:postalCode {postalcode} ; ksx:baseAddress {baseaddress} ; ksx:detailAddress {detailaddress} ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} .
source		SELECT "EnterpriseID" AS enterpriseid, "SiteID" AS siteid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "PlantID" AS plantid, "PlantName" AS plantname, "DialNumber" AS dialnumber, "CountryID" AS countryid, "PostalCode" AS postalcode, "BaseAddress" AS baseaddress, "DetailAddress" AS detailaddress FROM ksx."Plant"

mappingId	Department
target		d:{enterpriseid}/Department/{departmentid} a ksx:Department ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:plantID {plantid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:departmentID {departmentid} ; ksx:departmentName {departmentname} ; ksx:parentDepartmentID {parentdepartmentid} ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refPlant d:{enterpriseid}/Plant/{plantid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} ; ksx:refParentDepartment d:{enterpriseid}/Department/{parentdepartmentid} .
source		SELECT "EnterpriseID" AS enterpriseid, "SiteID" AS siteid, "PlantID" AS plantid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "DepartmentID" AS departmentid, "DepartmentName" AS departmentname, "ParentDepartmentID" AS parentdepartmentid FROM ksx."Department"

mappingId	Personnel
target		d:{enterpriseid}/Personnel/{personnelid} a ksx:Personnel ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:plantID {plantid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:personnelID {personnelid} ; ksx:personnelName {personnelname} ; ksx:departmentID {departmentid} ; ksx:employmentStatusType d:codelist/EmploymentStatusType/{employmentstatustype} ; ksx:personInChargeEmail {personinchargeemail} ; ksx:personInChargeDialNumber {personinchargedialnumber} ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refPlant d:{enterpriseid}/Plant/{plantid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} ; ksx:refDepartment d:{enterpriseid}/Department/{departmentid} .
source		SELECT "EnterpriseID" AS enterpriseid, "SiteID" AS siteid, "PlantID" AS plantid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "PersonnelID" AS personnelid, "PersonnelName" AS personnelname, "DepartmentID" AS departmentid, "EmploymentStatusType" AS employmentstatustype, "PersonInChargeEmail" AS personinchargeemail, "PersonInChargeDialNumber" AS personinchargedialnumber FROM ksx."Personnel"

mappingId	CustomerPartyMaster
target		d:{enterpriseid}/CustomerPartyMaster/{customerid} a ksx:CustomerPartyMaster ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:plantID {plantid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:customerID {customerid} ; ksx:customerName {customername} ; ksx:businessRegistrationNumber {businessregistrationnumber} ; ksx:representativeName {representativename} ; ksx:countryID d:codelist/CountryID/{countryid} ; ksx:postalCode {postalcode} ; ksx:baseAddress {baseaddress} ; ksx:detailAddress {detailaddress} ; ksx:dialNumber {dialnumber} ; ksx:faxNumber {faxnumber} ; ksx:useIndicator {useindicator}^^xsd:boolean ; ksx:personInChargeName {personinchargename} ; ksx:personInChargeEmail {personinchargeemail} ; ksx:personInChargeDialNumber {personinchargedialnumber} ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refPlant d:{enterpriseid}/Plant/{plantid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} .
