target		d:{enterpriseid}/VendorPartyMaster/{vendorid} a ksx:VendorPartyMaster ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:plantID {plantid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:vendorID {vendorid} ; ksx:vendorName {vendorname} ; ksx:businessRegistrationNumber {businessregistrationnumber} ; ksx:representativeName {representativename} ; ksx:countryID d:codelist/CountryID/{countryid} ; ksx:postalCode {postalcode} ; ksx:baseAddress {baseaddress} ; ksx:detailAddress {detailaddress} ; ksx:dialNumber {dialnumber} ; ksx:faxNumber {faxnumber} ; ksx:useIndicator {useindicator}^^xsd:boolean ; ksx:personInChargeName {personinchargename} ; ksx:personInChargeEmail {personinchargeemail} ; ksx:personInChargeDialNumber {personinchargedialnumber} ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refPlant d:{enterpriseid}/Plant/{plantid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} .
source		SELECT "EnterpriseID" AS enterpriseid, "SiteID" AS siteid, "PlantID" AS plantid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "VendorID" AS vendorid, "VendorName" AS vendorname, "BusinessRegistrationNumber" AS businessregistrationnumber, "RepresentativeName" AS representativename, "CountryID" AS countryid, "PostalCode" AS postalcode, "BaseAddress" AS baseaddress, "DetailAddress" AS detailaddress, "DialNumber" AS dialnumber, "FaxNumber" AS faxnumber, "UseIndicator" AS useindicator, "PersonInChargeName" AS personinchargename, "PersonInChargeEmail" AS personinchargeemail, "PersonInChargeDialNumber" AS personinchargedialnumber FROM ksx."VendorPartyMaster"

mappingId	CommonCodeMaster
target		d:{enterpriseid}/CommonCodeMaster/{commoncodegroup}_{commoncodeid} a ksx:CommonCodeMaster ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:plantID {plantid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:commonCodeID {commoncodeid} ; ksx:commonCodeName {commoncodename} ; ksx:commonCodeGroup {commoncodegroup} ; ksx:parentCommonCodeGroup {parentcommoncodegroup} ; ksx:parentCommonCodeID {parentcommoncodeid} ; ksx:commonCodeSequence {commoncodesequence}^^xsd:integer ; ksx:useIndicator {useindicator}^^xsd:boolean ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refPlant d:{enterpriseid}/Plant/{plantid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} ; ksx:refCommonCodeMaster d:{enterpriseid}/CommonCodeMaster/{parentcommoncodegroup}_{parentcommoncodeid} .
source		SELECT "EnterpriseID" AS enterpriseid, "SiteID" AS siteid, "PlantID" AS plantid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "CommonCodeID" AS commoncodeid, "CommonCodeName" AS commoncodename, "CommonCodeGroup" AS commoncodegroup, "ParentCommonCodeGroup" AS parentcommoncodegroup, "ParentCommonCodeID" AS parentcommoncodeid, "CommonCodeSequence" AS commoncodesequence, "UseIndicator" AS useindicator FROM ksx."CommonCodeMaster"

mappingId	WorkCalendar
target		d:{enterpriseid}/WorkCalendar/{calendarid} a ksx:WorkCalendar ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:plantID {plantid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:calendarID {calendarid} ; ksx:calendarType d:codelist/CalendarType/{calendartype} ; ksx:calendarDate {calendardate}^^xsd:date ; ksx:dayOfWeek d:codelist/DayOfWeek/{dayofweek} ; ksx:weekOfYear {weekofyear}^^xsd:integer ; ksx:dayOfYear {dayofyear}^^xsd:integer ; ksx:scheduleType d:codelist/ScheduleType/{scheduletype} ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refPlant d:{enterpriseid}/Plant/{plantid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} .
source		SELECT "EnterpriseID" AS enterpriseid, "SiteID" AS siteid, "PlantID" AS plantid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "CalendarID" AS calendarid, "CalendarType" AS calendartype, "CalendarDate" AS calendardate, "DayOfWeek" AS dayofweek, "WeekOfYear" AS weekofyear, "DayOfYear" AS dayofyear, "ScheduleType" AS scheduletype FROM ksx."WorkCalendar"

mappingId	UOMGroupHeader
target		d:{enterpriseid}/UOMGroup/{uomgroupid} a ksx:UOMGroup ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:plantID {plantid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:uomGroupID {uomgroupid} ; ksx:uomGroupName {uomgroupname} ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refPlant d:{enterpriseid}/Plant/{plantid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} .
source		SELECT "EnterpriseID" AS enterpriseid, "SiteID" AS siteid, "PlantID" AS plantid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "UOMGroupID" AS uomgroupid, "UOMGroupName" AS uomgroupname FROM ksx."UOMGroupHeader"

mappingId	UOMGroupLine
target		d:{enterpriseid}/UOMGroup/{uomgroupid}/line/{uomcode} a ksx:UOMGroupLine ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:plantID {plantid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:uomGroupID {uomgroupid} ; ksx:uomCode d:uom/{uomcode} ; ksx:uomCodeName {uomcodename} ; ksx:useIndicator {useindicator}^^xsd:boolean ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refPlant d:{enterpriseid}/Plant/{plantid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} .
source		SELECT "EnterpriseID" AS enterpriseid, "SiteID" AS siteid, "PlantID" AS plantid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "UOMGroupID" AS uomgroupid, "UOMCode" AS uomcode, "UOMCodeName" AS uomcodename, "UseIndicator" AS useindicator FROM ksx."UOMGroupLine"

mappingId	UOMGroupLine_hasLine
target		d:{enterpriseid}/UOMGroup/{uomgroupid} ksx:hasLine d:{enterpriseid}/UOMGroup/{uomgroupid}/line/{uomcode} . d:{enterpriseid}/UOMGroup/{uomgroupid}/line/{uomcode} ksx:lineOf d:{enterpriseid}/UOMGroup/{uomgroupid} .
source		SELECT "EnterpriseID" AS enterpriseid, "UOMCode" AS uomcode, "UOMGroupID" AS uomgroupid FROM ksx."UOMGroupLine"

mappingId	ItemMaster
target		d:{enterpriseid}/ItemMaster/{itemid} a ksx:ItemMaster ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:plantID {plantid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:itemID {itemid} ; ksx:itemName {itemname} ; ksx:itemType d:codelist/ItemType/{itemtype} ; ksx:phantomIndicator {phantomindicator}^^xsd:boolean ; ksx:itemLargeClass d:codelist/ItemLargeClass/{itemlargeclass} ; ksx:itemMediumClass d:codelist/ItemMediumClass/{itemmediumclass} ; ksx:itemSmallClass d:codelist/ItemSmallClass/{itemsmallclass} ; ksx:modelName {modelname} ; ksx:itemSpecification {itemspecification} ; ksx:itemDetailSpecification {itemdetailspecification} ; ksx:useIndicator {useindicator}^^xsd:boolean ; ksx:countryOfOrigin {countryoforigin} ; ksx:placeOfOrigin {placeoforigin} ; ksx:itemUOMCode d:uom/{itemuomcode} ; ksx:weight {weight}^^xsd:decimal ; ksx:netWeight {netweight}^^xsd:decimal ; ksx:weightUOMCode d:uom/{weightuomcode} ; ksx:volume {volume}^^xsd:decimal ; ksx:volumeUOMCode d:uom/{volumeuomcode} ; ksx:length {length}^^xsd:decimal ; ksx:width {width}^^xsd:decimal ; ksx:height {height}^^xsd:decimal ; ksx:dimensionUOMCode d:uom/{dimensionuomcode} ; ksx:validEndDate {validenddate}^^xsd:date ; ksx:drawingNumber {drawingnumber} ; ksx:lotControlIndicator {lotcontrolindicator}^^xsd:boolean ; ksx:purchaseLeadTime {purchaseleadtime}^^xsd:duration ; ksx:productionLeadTime {productionleadtime}^^xsd:duration ; ksx:lotSize {lotsize}^^xsd:decimal ; ksx:mainCustomerID {maincustomerid} ; ksx:mainVendorID {mainvendorid} ; ksx:safetyStock {safetystock}^^xsd:decimal ; ksx:maximumStockLevel {maximumstocklevel}^^xsd:decimal ; ksx:receiptWarehouseID {receiptwarehouseid} ; ksx:issueWarehouseID {issuewarehouseid} ; ksx:abcClass d:codelist/ABCClass/{abcclass} ; ksx:replacementItemID {replacementitemid} ; ksx:incomingInspectionIndicator {incominginspectionindicator}^^xsd:boolean ; ksx:finalInspectionIndicator {finalinspectionindicator}^^xsd:boolean ; ksx:outgoingInspectionIndicator {outgoinginspectionindicator}^^xsd:boolean ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refPlant d:{enterpriseid}/Plant/{plantid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} ; ksx:refMainCustomer d:{enterpriseid}/CustomerPartyMaster/{maincustomerid} ; ksx:refMainVendor d:{enterpriseid}/VendorPartyMaster/{mainvendorid} ; ksx:refReceiptWarehouse d:{enterpriseid}/WarehouseLocation/{receiptwarehouseid} ; ksx:refIssueWarehouse d:{enterpriseid}/WarehouseLocation/{issuewarehouseid} ; ksx:refReplacementItem d:{enterpriseid}/ItemMaster/{replacementitemid} .
source		SELECT "EnterpriseID" AS enterpriseid, "SiteID" AS siteid, "PlantID" AS plantid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "ItemID" AS itemid, "ItemName" AS itemname, "ItemType" AS itemtype, "PhantomIndicator" AS phantomindicator, "ItemLargeClass" AS itemlargeclass, "ItemMediumClass" AS itemmediumclass, "ItemSmallClass" AS itemsmallclass, "ModelName" AS modelname, "ItemSpecification" AS itemspecification, "ItemDetailSpecification" AS itemdetailspecification, "UseIndicator" AS useindicator, "CountryOfOrigin" AS countryoforigin, "PlaceOfOrigin" AS placeoforigin, "ItemUOMCode" AS itemuomcode, "Weight" AS weight, "NetWeight" AS netweight, "WeightUOMCode" AS weightuomcode, "Volume" AS volume, "VolumeUOMCode" AS volumeuomcode, "Length" AS length, "Width" AS width, "Height" AS height, "DimensionUOMCode" AS dimensionuomcode, "ValidEndDate" AS validenddate, "DrawingNumber" AS drawingnumber, "LotControlIndicator" AS lotcontrolindicator, "PurchaseLeadTime" AS purchaseleadtime, "ProductionLeadTime" AS productionleadtime, "LotSize" AS lotsize, "MainCustomerID" AS maincustomerid, "MainVendorID" AS mainvendorid, "SafetyStock" AS safetystock, "MaximumStockLevel" AS maximumstocklevel, "ReceiptWarehouseID" AS receiptwarehouseid, "IssueWarehouseID" AS issuewarehouseid, "ABCClass" AS abcclass, "ReplacementItemID" AS replacementitemid, "IncomingInspectionIndicator" AS incominginspectionindicator, "FinalInspectionIndicator" AS finalinspectionindicator, "OutgoingInspectionIndicator" AS outgoinginspectionindicator FROM ksx."ItemMaster"

mappingId	BOMHeader
target		d:{enterpriseid}/BOM/{bomid}_{bomrevisionnumber} a ksx:BOM ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:plantID {plantid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:bomID {bomid} ; ksx:bomRevisionNumber {bomrevisionnumber}^^xsd:integer ; ksx:bomType d:codelist/BOMType/{bomtype} ; ksx:itemID {itemid} ; ksx:bomQuantity {bomquantity}^^xsd:decimal ; ksx:itemUOMCode d:uom/{itemuomcode} ; ksx:routingID {routingid} ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refPlant d:{enterpriseid}/Plant/{plantid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} ; ksx:refItem d:{enterpriseid}/ItemMaster/{itemid} ; ksx:refRouting d:{enterpriseid}/Routing/{routingid} .
source		SELECT "EnterpriseID" AS enterpriseid, "SiteID" AS siteid, "PlantID" AS plantid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "BOMID" AS bomid, "BOMRevisionNumber" AS bomrevisionnumber, "BOMType" AS bomtype, "ItemID" AS itemid, "BOMQuantity" AS bomquantity, "ItemUOMCode" AS itemuomcode, "RoutingID" AS routingid FROM ksx."BOMHeader"

mappingId	BOMLine
target		d:{enterpriseid}/BOM/{bomid}_{bomrevisionnumber}/line/{bomlinesequence} a ksx:BOMLine ; ksx:enterpriseID {enterpriseid} ; ksx:siteID {siteid} ; ksx:plantID {plantid} ; ksx:creatorID {creatorid} ; ksx:creationDateTime {creationdatetime}^^xsd:dateTime ; ksx:modifierID {modifierid} ; ksx:modificationDateTime {modificationdatetime}^^xsd:dateTime ; ksx:note {note} ; ksx:bomID {bomid} ; ksx:bomRevisionNumber {bomrevisionnumber}^^xsd:integer ; ksx:bomLineSequence {bomlinesequence}^^xsd:integer ; ksx:childItemID {childitemid} ; ksx:childItemUOMCode d:uom/{childitemuomcode} ; ksx:actualRequirementQuantity {actualrequirementquantity}^^xsd:decimal ; ksx:operationSequence {operationsequence}^^xsd:integer ; ksx:backFlushedIndicator {backflushedindicator}^^xsd:boolean ; ksx:validStartDateTime {validstartdatetime}^^xsd:dateTime ; ksx:validEndDateTime {validenddatetime}^^xsd:dateTime ; ksx:refEnterprise d:{enterpriseid}/Enterprise/{enterpriseid} ; ksx:refSite d:{enterpriseid}/Site/{siteid} ; ksx:refPlant d:{enterpriseid}/Plant/{plantid} ; ksx:refCreator d:{enterpriseid}/Personnel/{creatorid} ; ksx:refModifier d:{enterpriseid}/Personnel/{modifierid} ; ksx:refChildItem d:{enterpriseid}/ItemMaster/{childitemid} .
source		SELECT "EnterpriseID" AS enterpriseid, "SiteID" AS siteid, "PlantID" AS plantid, "CreatorID" AS creatorid, "CreationDateTime" AS creationdatetime, "ModifierID" AS modifierid, "ModificationDateTime" AS modificationdatetime, "Note" AS note, "BOMID" AS bomid, "BOMRevisionNumber" AS bomrevisionnumber, "BOMLineSequence" AS bomlinesequence, "ChildItemID" AS childitemid, "ChildItemUOMCode" AS childitemuomcode, "ActualRequirementQuantity" AS actualrequirementquantity, "OperationSequence" AS operationsequence, "BackFlushedIndicator" AS backflushedindicator, "ValidStartDateTime" AS validstartdatetime, "ValidEndDateTime" AS validenddatetime FROM ksx."BOMLine"

mappingId	BOMLine_hasLine
target		d:{enterpriseid}/BOM/{bomid}_{bomrevisionnumber} ksx:hasLine d:{enterpriseid}/BOM/{bomid}_{bomrevisionnumber}/line/{bomlinesequence} . d:{enterpriseid}/BOM/{bomid}_{bomrevisionnumber}/line/{bomlinesequence} ksx:lineOf d:{enterpriseid}/BOM/{bomid}_{bomrevisionnumber} .
