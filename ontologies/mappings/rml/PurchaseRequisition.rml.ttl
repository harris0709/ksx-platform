# PurchaseRequisition — ksxgen 생성물(OBDA PurchaseRequisition와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:PurchaseRequisition a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT q.*, CASE WHEN q.siteid IS NULL OR q.plantid IS NULL THEN 'https://data.impix.co.kr/graph/' || q.enterpriseid ELSE 'https://data.impix.co.kr/graph/' || q.enterpriseid || '/' || q.siteid || '/' || q.plantid END AS kg_graph FROM (SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"PurchaseRequisitionID\"::text AS purchaserequisitionid, \"PurchaseRequisitionRevisionNumber\" AS purchaserequisitionrevisionnumber, \"ItemID\"::text AS itemid, \"ItemName\" AS itemname, \"DemandQuantity\" AS demandquantity, \"ItemUOMCode\"::text AS itemuomcode, \"PurchaseRequisitionUnitPrice\" AS purchaserequisitionunitprice, \"CurrencyCode\"::text AS currencycode, \"VendorID\"::text AS vendorid, \"VendorName\" AS vendorname, \"RequestedDeliveryDate\" AS requesteddeliverydate, \"RequesterDepartmentID\"::text AS requesterdepartmentid, \"RequesterPersonnelID\"::text AS requesterpersonnelid FROM ksx.\"PurchaseRequisition\") AS q" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/PurchaseRequisition/{purchaserequisitionid}" ; rr:class ksx:PurchaseRequisition ; rr:graphMap [ rr:column "kg_graph" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseRequisitionID ; rr:objectMap [ rr:column "purchaserequisitionid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseRequisitionRevisionNumber ; rr:objectMap [ rr:column "purchaserequisitionrevisionnumber" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemID ; rr:objectMap [ rr:column "itemid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemName ; rr:objectMap [ rr:column "itemname" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:demandQuantity ; rr:objectMap [ rr:column "demandquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemUOMCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/uom/{itemuomcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseRequisitionUnitPrice ; rr:objectMap [ rr:column "purchaserequisitionunitprice" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:currencyCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/CurrencyCode/{currencycode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:vendorID ; rr:objectMap [ rr:column "vendorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:vendorName ; rr:objectMap [ rr:column "vendorname" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:requestedDeliveryDate ; rr:objectMap [ rr:column "requesteddeliverydate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:requesterDepartmentID ; rr:objectMap [ rr:column "requesterdepartmentid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:requesterPersonnelID ; rr:objectMap [ rr:column "requesterpersonnelid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refItem ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ItemMaster/{itemid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refVendor ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/VendorPartyMaster/{vendorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refRequesterDepartment ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Department/{requesterdepartmentid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refRequesterPersonnel ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{requesterpersonnelid}" ] ] .
