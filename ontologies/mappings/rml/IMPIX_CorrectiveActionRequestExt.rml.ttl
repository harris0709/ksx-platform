# IMPIX_CorrectiveActionRequestExt — ksxgen 생성물(OBDA IMPIX_CorrectiveActionRequestExt와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix impix: <https://ontology.impix.co.kr/ext/impix/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:IMPIX_CorrectiveActionRequestExt a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\" AS enterpriseid, \"CorrectiveActionRequestID\" AS correctiveactionrequestid, \"DetectionLocationType\" AS detectionlocationtype, \"DefectQuantity\" AS defectquantity, \"DefectTypeCode\" AS defecttypecode, \"DefectTypeDetailCode\" AS defecttypedetailcode, \"CorrectiveActionDueDate\" AS correctiveactionduedate, \"OccurrenceDate\" AS occurrencedate, \"InspectionResultID\" AS inspectionresultid FROM ext.\"CorrectiveActionRequestExt\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/CorrectiveActionRequest/{correctiveactionrequestid}" ] ;
    rr:predicateObjectMap [ rr:predicate impix:detectionLocationType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/DetectionLocationType/{detectionlocationtype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:defectQuantity ; rr:objectMap [ rr:column "defectquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:defectTypeCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/DefectTypeCode/{defecttypecode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:defectTypeDetailCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/DefectTypeDetailCode/{defecttypedetailcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:correctiveActionDueDate ; rr:objectMap [ rr:column "correctiveactionduedate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:occurrenceDate ; rr:objectMap [ rr:column "occurrencedate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:inspectionResultID ; rr:objectMap [ rr:column "inspectionresultid" ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:refInspectionResult ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/SupplierInspectionResult/{inspectionresultid}" ] ] .
