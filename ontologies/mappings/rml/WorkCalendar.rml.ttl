# WorkCalendar — ksxgen 생성물(OBDA WorkCalendar와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:WorkCalendar a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"CalendarID\"::text AS calendarid, \"CalendarType\"::text AS calendartype, \"CalendarDate\" AS calendardate, \"DayOfWeek\"::text AS dayofweek, \"WeekOfYear\" AS weekofyear, \"DayOfYear\" AS dayofyear, \"ScheduleType\"::text AS scheduletype FROM ksx.\"WorkCalendar\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/WorkCalendar/{calendarid}" ; rr:class ksx:WorkCalendar ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:calendarID ; rr:objectMap [ rr:column "calendarid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:calendarType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/CalendarType/{calendartype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:calendarDate ; rr:objectMap [ rr:column "calendardate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:dayOfWeek ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/DayOfWeek/{dayofweek}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:weekOfYear ; rr:objectMap [ rr:column "weekofyear" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:dayOfYear ; rr:objectMap [ rr:column "dayofyear" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:scheduleType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/ScheduleType/{scheduletype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] .
