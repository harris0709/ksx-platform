# EquipmentState — ksxgen 생성물(OBDA EquipmentState와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:EquipmentState a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT q.*, CASE WHEN q.siteid IS NULL OR q.plantid IS NULL THEN 'https://data.impix.co.kr/graph/' || q.enterpriseid ELSE 'https://data.impix.co.kr/graph/' || q.enterpriseid || '/' || q.siteid || '/' || q.plantid END AS kg_graph FROM (SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"EquipmentStateID\"::text AS equipmentstateid, \"EquipmentID\"::text AS equipmentid, \"EquipmentState\"::text AS equipmentstate, \"EquipmentControlMode\"::text AS equipmentcontrolmode, \"EquipmentOperationMode\"::text AS equipmentoperationmode, \"ProcessedLotQuantity\" AS processedlotquantity, \"LastProcessedLotID\"::text AS lastprocessedlotid, \"LastProcessedOperationID\"::text AS lastprocessedoperationid, \"ErrorCode\"::text AS errorcode, \"ErrorMessage\" AS errormessage FROM ksx.\"EquipmentState\") AS q" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/EquipmentState/{equipmentstateid}" ; rr:class ksx:EquipmentState ; rr:graphMap [ rr:column "kg_graph" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentStateID ; rr:objectMap [ rr:column "equipmentstateid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentID ; rr:objectMap [ rr:column "equipmentid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentState ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/EquipmentState/{equipmentstate}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentControlMode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/EquipmentControlMode/{equipmentcontrolmode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentOperationMode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/EquipmentOperationMode/{equipmentoperationmode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:processedLotQuantity ; rr:objectMap [ rr:column "processedlotquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:lastProcessedLotID ; rr:objectMap [ rr:column "lastprocessedlotid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:lastProcessedOperationID ; rr:objectMap [ rr:column "lastprocessedoperationid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:errorCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/EquipmentErrorCode/{errorcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:errorMessage ; rr:objectMap [ rr:column "errormessage" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEquipment ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Equipment/{equipmentid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refLastProcessedLot ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Lot/{lastprocessedlotid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refLastProcessedOperation ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Operation/{lastprocessedoperationid}" ] ] .
