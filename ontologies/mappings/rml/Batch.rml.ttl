# Batch — ksxgen 생성물(OBDA Batch와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:Batch a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\" AS enterpriseid, \"SiteID\" AS siteid, \"PlantID\" AS plantid, \"CreatorID\" AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\" AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"BatchID\" AS batchid, \"BatchName\" AS batchname, \"BatchDescription\" AS batchdescription, \"BatchType\" AS batchtype, \"ParentBatchID\" AS parentbatchid, \"ItemID\" AS itemid, \"LotID\" AS lotid, \"ProductionOrderID\" AS productionorderid, \"ProductionOrderSequence\" AS productionordersequence, \"BOMID\" AS bomid, \"BOMRevisionNumber\" AS bomrevisionnumber, \"RecipeID\" AS recipeid, \"RecipeVersion\" AS recipeversion, \"OperationID\" AS operationid, \"EquipmentID\" AS equipmentid, \"BatchState\" AS batchstate, \"HoldIndicator\" AS holdindicator, \"ReworkIndicator\" AS reworkindicator, \"QualityDispositionCode\" AS qualitydispositioncode, \"BatchPlannedQuantity\" AS batchplannedquantity, \"ProducedQuantity\" AS producedquantity, \"DefectQuantity\" AS defectquantity, \"ItemUOMCode\" AS itemuomcode, \"ScheduleStartDateTime\" AS schedulestartdatetime, \"ScheduleEndDateTime\" AS scheduleenddatetime, \"BatchStartDateTime\" AS batchstartdatetime, \"BatchEndDateTime\" AS batchenddatetime, \"ManufactureDate\" AS manufacturedate, \"ValidEndDate\" AS validenddate, \"PersonnelID\" AS personnelid FROM ksx.\"Batch\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Batch/{batchid}" ; rr:class ksx:Batch ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:batchID ; rr:objectMap [ rr:column "batchid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:batchName ; rr:objectMap [ rr:column "batchname" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:batchDescription ; rr:objectMap [ rr:column "batchdescription" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:batchType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/BatchType/{batchtype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:parentBatchID ; rr:objectMap [ rr:column "parentbatchid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemID ; rr:objectMap [ rr:column "itemid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:lotID ; rr:objectMap [ rr:column "lotid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:productionOrderID ; rr:objectMap [ rr:column "productionorderid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:productionOrderSequence ; rr:objectMap [ rr:column "productionordersequence" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:bomID ; rr:objectMap [ rr:column "bomid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:bomRevisionNumber ; rr:objectMap [ rr:column "bomrevisionnumber" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:recipeID ; rr:objectMap [ rr:column "recipeid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:recipeVersion ; rr:objectMap [ rr:column "recipeversion" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:operationID ; rr:objectMap [ rr:column "operationid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentID ; rr:objectMap [ rr:column "equipmentid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:batchState ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/BatchState/{batchstate}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:holdIndicator ; rr:objectMap [ rr:column "holdindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:reworkIndicator ; rr:objectMap [ rr:column "reworkindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:qualityDispositionCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/QualityDispositionCode/{qualitydispositioncode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:batchPlannedQuantity ; rr:objectMap [ rr:column "batchplannedquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:producedQuantity ; rr:objectMap [ rr:column "producedquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:defectQuantity ; rr:objectMap [ rr:column "defectquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemUOMCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/uom/{itemuomcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:scheduleStartDateTime ; rr:objectMap [ rr:column "schedulestartdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:scheduleEndDateTime ; rr:objectMap [ rr:column "scheduleenddatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:batchStartDateTime ; rr:objectMap [ rr:column "batchstartdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:batchEndDateTime ; rr:objectMap [ rr:column "batchenddatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:manufactureDate ; rr:objectMap [ rr:column "manufacturedate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:validEndDate ; rr:objectMap [ rr:column "validenddate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:personnelID ; rr:objectMap [ rr:column "personnelid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refParentBatch ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Batch/{parentbatchid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refItem ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ItemMaster/{itemid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refLot ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Lot/{lotid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refProductionOrder ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ProductionOrder/{productionorderid}_{productionordersequence}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refBOM ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/BOM/{bomid}_{bomrevisionnumber}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refOperation ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Operation/{operationid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEquipment ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Equipment/{equipmentid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPersonnel ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{personnelid}" ] ] .
