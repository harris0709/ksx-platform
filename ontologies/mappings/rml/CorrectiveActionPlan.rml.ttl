# CorrectiveActionPlan — ksxgen 생성물(OBDA CorrectiveActionPlan와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:CorrectiveActionPlan a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"VendorID\"::text AS vendorid, \"ItemID\"::text AS itemid, \"ItemName\" AS itemname, \"LotID\"::text AS lotid, \"BatchID\"::text AS batchid, \"CorrectiveActionRequestID\"::text AS correctiveactionrequestid, \"CorrectiveActionPlanID\"::text AS correctiveactionplanid, \"PersonInChargeID\"::text AS personinchargeid, \"PersonInChargeEmail\" AS personinchargeemail, \"PersonInChargeDialNumber\" AS personinchargedialnumber, \"ExpectedCorrectiveActionDate\" AS expectedcorrectiveactiondate, \"CorrectiveActionRequestDocumentReference\" AS correctiveactionrequestdocumentreference, \"CorrectiveActionApprovalIndicator\" AS correctiveactionapprovalindicator, \"CorrectiveActionStatusCode\"::text AS correctiveactionstatuscode, \"ReasonForRejection\" AS reasonforrejection FROM ksx.\"CorrectiveActionPlan\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/CorrectiveActionPlan/{correctiveactionplanid}" ; rr:class ksx:CorrectiveActionPlan ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:vendorID ; rr:objectMap [ rr:column "vendorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemID ; rr:objectMap [ rr:column "itemid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemName ; rr:objectMap [ rr:column "itemname" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:lotID ; rr:objectMap [ rr:column "lotid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:batchID ; rr:objectMap [ rr:column "batchid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:correctiveActionRequestID ; rr:objectMap [ rr:column "correctiveactionrequestid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:correctiveActionPlanID ; rr:objectMap [ rr:column "correctiveactionplanid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:personInChargeID ; rr:objectMap [ rr:column "personinchargeid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:personInChargeEmail ; rr:objectMap [ rr:column "personinchargeemail" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:personInChargeDialNumber ; rr:objectMap [ rr:column "personinchargedialnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:expectedCorrectiveActionDate ; rr:objectMap [ rr:column "expectedcorrectiveactiondate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:correctiveActionRequestDocumentReference ; rr:objectMap [ rr:column "correctiveactionrequestdocumentreference" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:correctiveActionApprovalIndicator ; rr:objectMap [ rr:column "correctiveactionapprovalindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:correctiveActionStatusCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/CorrectiveActionStatusCode/{correctiveactionstatuscode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:reasonForRejection ; rr:objectMap [ rr:column "reasonforrejection" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refVendor ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/VendorPartyMaster/{vendorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refItem ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ItemMaster/{itemid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refLot ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Lot/{lotid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refBatch ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Batch/{batchid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCorrectiveActionRequest ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/CorrectiveActionRequest/{correctiveactionrequestid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPersonInCharge ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{personinchargeid}" ] ] .
