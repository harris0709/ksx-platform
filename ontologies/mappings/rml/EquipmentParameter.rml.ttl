# EquipmentParameter — ksxgen 생성물(OBDA EquipmentParameter와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:EquipmentParameter a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"ParameterID\"::text AS parameterid, \"ParameterName\" AS parametername, \"ParameterType\"::text AS parametertype, \"ParameterGrade\"::text AS parametergrade, \"ParameterUOMCode\"::text AS parameteruomcode, \"EquipmentID\"::text AS equipmentid, \"LSL\" AS lsl, \"USL\" AS usl, \"PeriodicDataCollectionIndicator\" AS periodicdatacollectionindicator, CASE WHEN \"DataCollectionPeriod\" IS NULL THEN NULL ELSE 'P' || extract(year FROM \"DataCollectionPeriod\")::int || 'Y' || extract(month FROM \"DataCollectionPeriod\")::int || 'M' || extract(day FROM \"DataCollectionPeriod\")::int || 'DT' || extract(hour FROM \"DataCollectionPeriod\")::int || 'H' || extract(minute FROM \"DataCollectionPeriod\")::int || 'M' || trim_scale(extract(second FROM \"DataCollectionPeriod\")) || 'S' END AS datacollectionperiod FROM ksx.\"EquipmentParameter\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/EquipmentParameter/{parameterid}" ; rr:class ksx:EquipmentParameter ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:parameterID ; rr:objectMap [ rr:column "parameterid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:parameterName ; rr:objectMap [ rr:column "parametername" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:parameterType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/ParameterType/{parametertype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:parameterGrade ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/ParameterGrade/{parametergrade}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:parameterUOMCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/uom/{parameteruomcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentID ; rr:objectMap [ rr:column "equipmentid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:lsl ; rr:objectMap [ rr:column "lsl" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:usl ; rr:objectMap [ rr:column "usl" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:periodicDataCollectionIndicator ; rr:objectMap [ rr:column "periodicdatacollectionindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:dataCollectionPeriod ; rr:objectMap [ rr:column "datacollectionperiod" ; rr:datatype xsd:duration ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEquipment ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Equipment/{equipmentid}" ] ] .
