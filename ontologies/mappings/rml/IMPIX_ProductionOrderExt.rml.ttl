# IMPIX_ProductionOrderExt — ksxgen 생성물(OBDA IMPIX_ProductionOrderExt와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix impix: <https://ontology.impix.co.kr/ext/impix/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:IMPIX_ProductionOrderExt a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\" AS enterpriseid, \"ProductionOrderID\" AS productionorderid, \"ProductionOrderSequence\" AS productionordersequence, \"ProductionOrderStatusCode\" AS productionorderstatuscode FROM ext.\"ProductionOrderExt\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ProductionOrder/{productionorderid}_{productionordersequence}" ] ;
    rr:predicateObjectMap [ rr:predicate impix:productionOrderStatusCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/ProductionOrderStatusCode/{productionorderstatuscode}" ] ] .
