# IMPIX_ProductionOrderExt — ksxgen 생성물(OBDA IMPIX_ProductionOrderExt와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix impix: <https://ontology.impix.co.kr/ext/impix/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:IMPIX_ProductionOrderExt a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT q.*, CASE WHEN o.\"SiteID\" IS NULL OR o.\"PlantID\" IS NULL THEN 'https://data.impix.co.kr/graph/' || q.enterpriseid ELSE 'https://data.impix.co.kr/graph/' || q.enterpriseid || '/' || o.\"SiteID\" || '/' || o.\"PlantID\" END AS kg_graph FROM (SELECT \"EnterpriseID\"::text AS enterpriseid, \"ProductionOrderID\"::text AS productionorderid, \"ProductionOrderSequence\"::text AS productionordersequence, \"ProductionOrderStatusCode\"::text AS productionorderstatuscode FROM ext.\"ProductionOrderExt\") AS q LEFT JOIN ksx.\"ProductionOrder\" AS o ON o.\"EnterpriseID\"::text = q.enterpriseid::text AND o.\"ProductionOrderID\"::text = q.productionorderid::text AND o.\"ProductionOrderSequence\"::text = q.productionordersequence::text" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ProductionOrder/{productionorderid}_{productionordersequence}" ; rr:graphMap [ rr:column "kg_graph" ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:productionOrderStatusCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/ProductionOrderStatusCode/{productionorderstatuscode}" ] ] .
