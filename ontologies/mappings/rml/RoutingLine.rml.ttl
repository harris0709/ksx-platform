# RoutingLine — ksxgen 생성물(OBDA RoutingLine와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:RoutingLine a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"RoutingID\"::text AS routingid, \"OperationSequence\"::text AS operationsequence, \"OperationID\"::text AS operationid, \"LastOperationIndicator\" AS lastoperationindicator, CASE WHEN \"SetupTime\" IS NULL THEN NULL ELSE 'P' || extract(year FROM \"SetupTime\")::int || 'Y' || extract(month FROM \"SetupTime\")::int || 'M' || extract(day FROM \"SetupTime\")::int || 'DT' || extract(hour FROM \"SetupTime\")::int || 'H' || extract(minute FROM \"SetupTime\")::int || 'M' || trim_scale(extract(second FROM \"SetupTime\")) || 'S' END AS setuptime, CASE WHEN \"RunTime\" IS NULL THEN NULL ELSE 'P' || extract(year FROM \"RunTime\")::int || 'Y' || extract(month FROM \"RunTime\")::int || 'M' || extract(day FROM \"RunTime\")::int || 'DT' || extract(hour FROM \"RunTime\")::int || 'H' || extract(minute FROM \"RunTime\")::int || 'M' || trim_scale(extract(second FROM \"RunTime\")) || 'S' END AS runtime, CASE WHEN \"MoveTime\" IS NULL THEN NULL ELSE 'P' || extract(year FROM \"MoveTime\")::int || 'Y' || extract(month FROM \"MoveTime\")::int || 'M' || extract(day FROM \"MoveTime\")::int || 'DT' || extract(hour FROM \"MoveTime\")::int || 'H' || extract(minute FROM \"MoveTime\")::int || 'M' || trim_scale(extract(second FROM \"MoveTime\")) || 'S' END AS movetime FROM ksx.\"RoutingLine\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Routing/{routingid}/line/{operationsequence}" ; rr:class ksx:RoutingLine ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:routingID ; rr:objectMap [ rr:column "routingid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:operationSequence ; rr:objectMap [ rr:column "operationsequence" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:operationID ; rr:objectMap [ rr:column "operationid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:lastOperationIndicator ; rr:objectMap [ rr:column "lastoperationindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:setupTime ; rr:objectMap [ rr:column "setuptime" ; rr:datatype xsd:duration ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:runTime ; rr:objectMap [ rr:column "runtime" ; rr:datatype xsd:duration ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:moveTime ; rr:objectMap [ rr:column "movetime" ; rr:datatype xsd:duration ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refOperation ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Operation/{operationid}" ] ] .
