# IMPIX_StandardCost — ksxgen 생성물(OBDA IMPIX_StandardCost와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix impix: <https://ontology.impix.co.kr/ext/impix/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:IMPIX_StandardCost a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"StandardCostID\"::text AS standardcostid, \"ItemID\"::text AS itemid, \"OperationID\"::text AS operationid, \"CostPeriodStartDate\" AS costperiodstartdate, \"CostPeriodEndDate\" AS costperiodenddate, \"StandardCostAmount\" AS standardcostamount, \"MaterialCostAmount\" AS materialcostamount, \"LaborCostAmount\" AS laborcostamount, \"OverheadCostAmount\" AS overheadcostamount, \"CurrencyCode\"::text AS currencycode, \"ItemUOMCode\"::text AS itemuomcode FROM ext.\"StandardCost\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/StandardCost/{standardcostid}" ; rr:class impix:StandardCost ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:standardCostID ; rr:objectMap [ rr:column "standardcostid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemID ; rr:objectMap [ rr:column "itemid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:operationID ; rr:objectMap [ rr:column "operationid" ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:costPeriodStartDate ; rr:objectMap [ rr:column "costperiodstartdate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:costPeriodEndDate ; rr:objectMap [ rr:column "costperiodenddate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:standardCostAmount ; rr:objectMap [ rr:column "standardcostamount" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:materialCostAmount ; rr:objectMap [ rr:column "materialcostamount" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:laborCostAmount ; rr:objectMap [ rr:column "laborcostamount" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:overheadCostAmount ; rr:objectMap [ rr:column "overheadcostamount" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:currencyCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/CurrencyCode/{currencycode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemUOMCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/uom/{itemuomcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refItem ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ItemMaster/{itemid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refOperation ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Operation/{operationid}" ] ] .
