# Operation — ksxgen 생성물(OBDA Operation와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:Operation a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\" AS enterpriseid, \"SiteID\" AS siteid, \"PlantID\" AS plantid, \"CreatorID\" AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\" AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"OperationID\" AS operationid, \"OperationName\" AS operationname, \"OperationType\" AS operationtype, \"UseIndicator\" AS useindicator, \"OperationLargeClass\" AS operationlargeclass, \"OperationMediumClass\" AS operationmediumclass, \"OperationSmallClass\" AS operationsmallclass, \"BackFlushedIndicator\" AS backflushedindicator FROM ksx.\"Operation\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Operation/{operationid}" ; rr:class ksx:Operation ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:operationID ; rr:objectMap [ rr:column "operationid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:operationName ; rr:objectMap [ rr:column "operationname" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:operationType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/OperationType/{operationtype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:useIndicator ; rr:objectMap [ rr:column "useindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:operationLargeClass ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/OperationLargeClass/{operationlargeclass}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:operationMediumClass ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/OperationMediumClass/{operationmediumclass}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:operationSmallClass ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/OperationSmallClass/{operationsmallclass}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:backFlushedIndicator ; rr:objectMap [ rr:column "backflushedindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] .
