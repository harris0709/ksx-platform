# EngineeringChangeOrder — ksxgen 생성물(OBDA EngineeringChangeOrder와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:EngineeringChangeOrder a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT q.*, CASE WHEN q.siteid IS NULL OR q.plantid IS NULL THEN 'https://data.impix.co.kr/graph/' || q.enterpriseid ELSE 'https://data.impix.co.kr/graph/' || q.enterpriseid || '/' || q.siteid || '/' || q.plantid END AS kg_graph FROM (SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"EngineeringChangeOrderID\"::text AS engineeringchangeorderid, \"ItemID\"::text AS itemid, \"ValidStartDate\" AS validstartdate, \"ValidEndDate\" AS validenddate, \"ExpectedExecutionDate\" AS expectedexecutiondate, \"ExecutionDate\" AS executiondate, \"BOMType\"::text AS bomtype, \"BOMID\"::text AS bomid, \"BOMRevisionNumber\"::text AS bomrevisionnumber, \"ChildItemID\"::text AS childitemid, \"ItemUOMCode\"::text AS itemuomcode, \"ActualRequirementQuantity\" AS actualrequirementquantity FROM ksx.\"EngineeringChangeOrder\") AS q" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/EngineeringChangeOrder/{engineeringchangeorderid}" ; rr:class ksx:EngineeringChangeOrder ; rr:graphMap [ rr:column "kg_graph" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:engineeringChangeOrderID ; rr:objectMap [ rr:column "engineeringchangeorderid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemID ; rr:objectMap [ rr:column "itemid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:validStartDate ; rr:objectMap [ rr:column "validstartdate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:validEndDate ; rr:objectMap [ rr:column "validenddate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:expectedExecutionDate ; rr:objectMap [ rr:column "expectedexecutiondate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:executionDate ; rr:objectMap [ rr:column "executiondate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:bomType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/BOMType/{bomtype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:bomID ; rr:objectMap [ rr:column "bomid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:bomRevisionNumber ; rr:objectMap [ rr:column "bomrevisionnumber" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:childItemID ; rr:objectMap [ rr:column "childitemid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemUOMCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/uom/{itemuomcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:actualRequirementQuantity ; rr:objectMap [ rr:column "actualrequirementquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refItem ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ItemMaster/{itemid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refBOM ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/BOM/{bomid}_{bomrevisionnumber}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refChildItem ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ItemMaster/{childitemid}" ] ] .
