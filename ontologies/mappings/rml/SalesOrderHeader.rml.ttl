# SalesOrderHeader — ksxgen 생성물(OBDA SalesOrderHeader와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:SalesOrderHeader a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"SalesDocumentNumber\"::text AS salesdocumentnumber, \"SalesOrderType\"::text AS salesordertype, \"CustomerID\"::text AS customerid, \"SalesDate\" AS salesdate, \"SalesStatus\"::text AS salesstatus, \"ShipmentTermsCode\"::text AS shipmenttermscode, \"SalesTransactionType\"::text AS salestransactiontype, \"ReturnIndicator\" AS returnindicator, \"ExportIndicator\" AS exportindicator, \"SalesAutomaticApprovalIndicator\" AS salesautomaticapprovalindicator FROM ksx.\"SalesOrderHeader\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/SalesOrder/{salesdocumentnumber}" ; rr:class ksx:SalesOrder ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:salesDocumentNumber ; rr:objectMap [ rr:column "salesdocumentnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:salesOrderType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/SalesOrderType/{salesordertype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:customerID ; rr:objectMap [ rr:column "customerid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:salesDate ; rr:objectMap [ rr:column "salesdate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:salesStatus ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/SalesStatus/{salesstatus}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:shipmentTermsCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/ShipmentTermsCode/{shipmenttermscode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:salesTransactionType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/SalesTransactionType/{salestransactiontype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:returnIndicator ; rr:objectMap [ rr:column "returnindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:exportIndicator ; rr:objectMap [ rr:column "exportindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:salesAutomaticApprovalIndicator ; rr:objectMap [ rr:column "salesautomaticapprovalindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCustomer ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/CustomerPartyMaster/{customerid}" ] ] .
