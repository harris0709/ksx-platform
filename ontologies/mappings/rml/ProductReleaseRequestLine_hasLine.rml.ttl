# ProductReleaseRequestLine_hasLine — ksxgen 생성물(OBDA ProductReleaseRequestLine_hasLine와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:ProductReleaseRequestLine_hasLine a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT q.*, CASE WHEN o.\"SiteID\" IS NULL OR o.\"PlantID\" IS NULL THEN 'https://data.impix.co.kr/graph/' || q.enterpriseid ELSE 'https://data.impix.co.kr/graph/' || q.enterpriseid || '/' || o.\"SiteID\" || '/' || o.\"PlantID\" END AS kg_graph FROM (SELECT \"EnterpriseID\"::text AS enterpriseid, \"ProductReleaseRequestID\"::text AS productreleaserequestid, \"ProductReleaseRequestSequence\"::text AS productreleaserequestsequence FROM ksx.\"ProductReleaseRequestLine\") AS q LEFT JOIN ksx.\"ProductReleaseRequestHeader\" AS o ON o.\"EnterpriseID\"::text = q.enterpriseid::text AND o.\"ProductReleaseRequestID\"::text = q.productreleaserequestid::text" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ProductReleaseRequest/{productreleaserequestid}" ; rr:graphMap [ rr:column "kg_graph" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:hasLine ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ProductReleaseRequest/{productreleaserequestid}/line/{productreleaserequestsequence}" ] ] .

map:ProductReleaseRequestLine_hasLine_1 a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT q.*, CASE WHEN o.\"SiteID\" IS NULL OR o.\"PlantID\" IS NULL THEN 'https://data.impix.co.kr/graph/' || q.enterpriseid ELSE 'https://data.impix.co.kr/graph/' || q.enterpriseid || '/' || o.\"SiteID\" || '/' || o.\"PlantID\" END AS kg_graph FROM (SELECT \"EnterpriseID\"::text AS enterpriseid, \"ProductReleaseRequestID\"::text AS productreleaserequestid, \"ProductReleaseRequestSequence\"::text AS productreleaserequestsequence FROM ksx.\"ProductReleaseRequestLine\") AS q LEFT JOIN ksx.\"ProductReleaseRequestHeader\" AS o ON o.\"EnterpriseID\"::text = q.enterpriseid::text AND o.\"ProductReleaseRequestID\"::text = q.productreleaserequestid::text" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ProductReleaseRequest/{productreleaserequestid}/line/{productreleaserequestsequence}" ; rr:graphMap [ rr:column "kg_graph" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:lineOf ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ProductReleaseRequest/{productreleaserequestid}" ] ] .
