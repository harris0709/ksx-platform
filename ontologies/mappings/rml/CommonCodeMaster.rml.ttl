# CommonCodeMaster — ksxgen 생성물(OBDA CommonCodeMaster와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:CommonCodeMaster a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"CommonCodeID\"::text AS commoncodeid, \"CommonCodeName\" AS commoncodename, \"CommonCodeGroup\"::text AS commoncodegroup, \"ParentCommonCodeGroup\"::text AS parentcommoncodegroup, \"ParentCommonCodeID\"::text AS parentcommoncodeid, \"CommonCodeSequence\" AS commoncodesequence, \"UseIndicator\" AS useindicator FROM ksx.\"CommonCodeMaster\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/CommonCodeMaster/{commoncodegroup}_{commoncodeid}" ; rr:class ksx:CommonCodeMaster ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:commonCodeID ; rr:objectMap [ rr:column "commoncodeid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:commonCodeName ; rr:objectMap [ rr:column "commoncodename" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:commonCodeGroup ; rr:objectMap [ rr:column "commoncodegroup" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:parentCommonCodeGroup ; rr:objectMap [ rr:column "parentcommoncodegroup" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:parentCommonCodeID ; rr:objectMap [ rr:column "parentcommoncodeid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:commonCodeSequence ; rr:objectMap [ rr:column "commoncodesequence" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:useIndicator ; rr:objectMap [ rr:column "useindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCommonCodeMaster ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/CommonCodeMaster/{parentcommoncodegroup}_{parentcommoncodeid}" ] ] .
