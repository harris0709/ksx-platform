# SupplierInspectionPlan — ksxgen 생성물(OBDA SupplierInspectionPlan와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:SupplierInspectionPlan a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"VendorID\"::text AS vendorid, \"ProjectID\"::text AS projectid, \"ItemID\"::text AS itemid, \"ItemName\" AS itemname, \"ItemUOMCode\"::text AS itemuomcode, \"PurchaseDocumentNumber\"::text AS purchasedocumentnumber, \"PurchaseDocumentSequence\"::text AS purchasedocumentsequence, \"PurchaseOrderQuantity\" AS purchaseorderquantity, \"LotID\"::text AS lotid, \"BatchID\"::text AS batchid, \"ExpectedDeliveryDate\" AS expecteddeliverydate, \"InspectionPlanID\"::text AS inspectionplanid, \"InspectionID\"::text AS inspectionid, \"InspectionName\" AS inspectionname, \"Inspector\" AS inspector, \"InspectionLocation\" AS inspectionlocation, \"ExpectedInspectionDate\" AS expectedinspectiondate, \"ExpectedInspectionTimePeriod\" AS expectedinspectiontimeperiod, \"InspectionMethod\"::text AS inspectionmethod, \"InspectionPlanQuantity\" AS inspectionplanquantity, \"InspectionCheckSheet\" AS inspectionchecksheet FROM ksx.\"SupplierInspectionPlan\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/SupplierInspectionPlan/{inspectionplanid}_{inspectionid}" ; rr:class ksx:SupplierInspectionPlan ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:vendorID ; rr:objectMap [ rr:column "vendorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:projectID ; rr:objectMap [ rr:column "projectid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemID ; rr:objectMap [ rr:column "itemid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemName ; rr:objectMap [ rr:column "itemname" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemUOMCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/uom/{itemuomcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseDocumentNumber ; rr:objectMap [ rr:column "purchasedocumentnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseDocumentSequence ; rr:objectMap [ rr:column "purchasedocumentsequence" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseOrderQuantity ; rr:objectMap [ rr:column "purchaseorderquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:lotID ; rr:objectMap [ rr:column "lotid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:batchID ; rr:objectMap [ rr:column "batchid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:expectedDeliveryDate ; rr:objectMap [ rr:column "expecteddeliverydate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:inspectionPlanID ; rr:objectMap [ rr:column "inspectionplanid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:inspectionID ; rr:objectMap [ rr:column "inspectionid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:inspectionName ; rr:objectMap [ rr:column "inspectionname" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:inspector ; rr:objectMap [ rr:column "inspector" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:inspectionLocation ; rr:objectMap [ rr:column "inspectionlocation" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:expectedInspectionDate ; rr:objectMap [ rr:column "expectedinspectiondate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:expectedInspectionTimePeriod ; rr:objectMap [ rr:column "expectedinspectiontimeperiod" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:inspectionMethod ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/InspectionMethod/{inspectionmethod}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:inspectionPlanQuantity ; rr:objectMap [ rr:column "inspectionplanquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:inspectionCheckSheet ; rr:objectMap [ rr:column "inspectionchecksheet" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refVendor ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/VendorPartyMaster/{vendorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refProject ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ProjectMaster/{projectid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refItem ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ItemMaster/{itemid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPurchaseOrderLine ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/PurchaseOrder/{purchasedocumentnumber}/line/{purchasedocumentsequence}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refLot ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Lot/{lotid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refBatch ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Batch/{batchid}" ] ] .
