# IMPIX_SupplierInspectionResultExt — ksxgen 생성물(OBDA IMPIX_SupplierInspectionResultExt와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix impix: <https://ontology.impix.co.kr/ext/impix/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:IMPIX_SupplierInspectionResultExt a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\" AS enterpriseid, \"InspectionResultID\" AS inspectionresultid, \"GoodsReceiptID\" AS goodsreceiptid, \"GoodsReceiptSequence\" AS goodsreceiptsequence, \"DefectQuantity\" AS defectquantity, \"DefectTypeCode\" AS defecttypecode, \"DefectTypeDetailCode\" AS defecttypedetailcode FROM ext.\"SupplierInspectionResultExt\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/SupplierInspectionResult/{inspectionresultid}" ] ;
    rr:predicateObjectMap [ rr:predicate ksx:goodsReceiptID ; rr:objectMap [ rr:column "goodsreceiptid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:goodsReceiptSequence ; rr:objectMap [ rr:column "goodsreceiptsequence" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:defectQuantity ; rr:objectMap [ rr:column "defectquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:defectTypeCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/DefectTypeCode/{defecttypecode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:defectTypeDetailCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/DefectTypeDetailCode/{defecttypedetailcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:refGoodsReceipt ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/GoodsReceipt/{goodsreceiptid}_{goodsreceiptsequence}" ] ] .
