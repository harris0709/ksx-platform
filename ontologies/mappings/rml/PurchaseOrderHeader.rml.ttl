# PurchaseOrderHeader — ksxgen 생성물(OBDA PurchaseOrderHeader와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:PurchaseOrderHeader a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"PurchaseDocumentNumber\"::text AS purchasedocumentnumber, \"VendorID\"::text AS vendorid, \"PaymentTermsCode\"::text AS paymenttermscode, \"PurchaseGroupCode\"::text AS purchasegroupcode, \"CurrencyCode\"::text AS currencycode, \"ExchangeRate\" AS exchangerate, \"PurchaseApprovalDate\" AS purchaseapprovaldate, \"PurchaseOrderDate\" AS purchaseorderdate, \"PurchaseOrderTypeCode\"::text AS purchaseordertypecode, \"PurchaseTransactionType\"::text AS purchasetransactiontype, \"PurchaseOrderStartDate\" AS purchaseorderstartdate, \"PurchaseOrderValidDate\" AS purchaseordervaliddate, \"PersonnelID\"::text AS personnelid, \"PurchaseOrderClosingIndicator\" AS purchaseorderclosingindicator, \"PurchaseOrderClosingDate\" AS purchaseorderclosingdate FROM ksx.\"PurchaseOrderHeader\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/PurchaseOrder/{purchasedocumentnumber}" ; rr:class ksx:PurchaseOrder ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseDocumentNumber ; rr:objectMap [ rr:column "purchasedocumentnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:vendorID ; rr:objectMap [ rr:column "vendorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:paymentTermsCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/PaymentTermsCode/{paymenttermscode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseGroupCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/PurchaseGroupCode/{purchasegroupcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:currencyCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/CurrencyCode/{currencycode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:exchangeRate ; rr:objectMap [ rr:column "exchangerate" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseApprovalDate ; rr:objectMap [ rr:column "purchaseapprovaldate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseOrderDate ; rr:objectMap [ rr:column "purchaseorderdate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseOrderTypeCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/PurchaseOrderTypeCode/{purchaseordertypecode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseTransactionType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/PurchaseTransactionType/{purchasetransactiontype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseOrderStartDate ; rr:objectMap [ rr:column "purchaseorderstartdate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseOrderValidDate ; rr:objectMap [ rr:column "purchaseordervaliddate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:personnelID ; rr:objectMap [ rr:column "personnelid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseOrderClosingIndicator ; rr:objectMap [ rr:column "purchaseorderclosingindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseOrderClosingDate ; rr:objectMap [ rr:column "purchaseorderclosingdate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refVendor ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/VendorPartyMaster/{vendorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPersonnel ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{personnelid}" ] ] .
