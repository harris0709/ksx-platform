# ProductRelease — ksxgen 생성물(OBDA ProductRelease와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:ProductRelease a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"ProductReleaseID\"::text AS productreleaseid, \"ProductReleaseSequence\"::text AS productreleasesequence, \"ProductReleaseRequestID\"::text AS productreleaserequestid, \"SalesDocumentNumber\"::text AS salesdocumentnumber, \"SalesDocumentSequence\"::text AS salesdocumentsequence, \"InventoryTransactionDate\" AS inventorytransactiondate, \"LineID\"::text AS lineid, \"ItemID\"::text AS itemid, \"ItemName\" AS itemname, \"OrderUOMCode\"::text AS orderuomcode, \"OrderQuantity\" AS orderquantity, \"SellingUOMCode\"::text AS sellinguomcode, \"SalesQuantity\" AS salesquantity, \"ReturnIndicator\" AS returnindicator, \"ItemUOMCode\"::text AS itemuomcode, \"ItemUnitQuantity\" AS itemunitquantity, \"SalesUnitQuantity\" AS salesunitquantity, \"ReturnUnitQuantity\" AS returnunitquantity, \"CustomerID\"::text AS customerid, \"LotID\"::text AS lotid, \"SerialUseIndicator\" AS serialuseindicator, \"WarehouseID\"::text AS warehouseid FROM ksx.\"ProductRelease\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ProductRelease/{productreleaseid}_{productreleasesequence}" ; rr:class ksx:ProductRelease ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:productReleaseID ; rr:objectMap [ rr:column "productreleaseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:productReleaseSequence ; rr:objectMap [ rr:column "productreleasesequence" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:productReleaseRequestID ; rr:objectMap [ rr:column "productreleaserequestid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:salesDocumentNumber ; rr:objectMap [ rr:column "salesdocumentnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:salesDocumentSequence ; rr:objectMap [ rr:column "salesdocumentsequence" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:inventoryTransactionDate ; rr:objectMap [ rr:column "inventorytransactiondate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:lineID ; rr:objectMap [ rr:column "lineid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemID ; rr:objectMap [ rr:column "itemid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemName ; rr:objectMap [ rr:column "itemname" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:orderUOMCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/uom/{orderuomcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:orderQuantity ; rr:objectMap [ rr:column "orderquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:sellingUOMCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/uom/{sellinguomcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:salesQuantity ; rr:objectMap [ rr:column "salesquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:returnIndicator ; rr:objectMap [ rr:column "returnindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemUOMCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/uom/{itemuomcode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:itemUnitQuantity ; rr:objectMap [ rr:column "itemunitquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:salesUnitQuantity ; rr:objectMap [ rr:column "salesunitquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:returnUnitQuantity ; rr:objectMap [ rr:column "returnunitquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:customerID ; rr:objectMap [ rr:column "customerid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:lotID ; rr:objectMap [ rr:column "lotid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:serialUseIndicator ; rr:objectMap [ rr:column "serialuseindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:warehouseID ; rr:objectMap [ rr:column "warehouseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refProductReleaseRequest ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ProductReleaseRequest/{productreleaserequestid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSalesOrderLine ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/SalesOrder/{salesdocumentnumber}/line/{salesdocumentsequence}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refLine ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Line/{lineid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refItem ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ItemMaster/{itemid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCustomer ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/CustomerPartyMaster/{customerid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refLot ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Lot/{lotid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refWarehouse ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/WarehouseLocation/{warehouseid}" ] ] .
