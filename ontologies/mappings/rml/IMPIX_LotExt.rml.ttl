# IMPIX_LotExt — ksxgen 생성물(OBDA IMPIX_LotExt와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix impix: <https://ontology.impix.co.kr/ext/impix/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:IMPIX_LotExt a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"LotID\"::text AS lotid, \"LotOriginType\"::text AS lotorigintype, \"VendorID\"::text AS vendorid, \"VendorLotNumber\" AS vendorlotnumber FROM ext.\"LotExt\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Lot/{lotid}" ] ;
    rr:predicateObjectMap [ rr:predicate impix:lotOriginType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/LotOriginType/{lotorigintype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:vendorID ; rr:objectMap [ rr:column "vendorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:vendorLotNumber ; rr:objectMap [ rr:column "vendorlotnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refVendor ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/VendorPartyMaster/{vendorid}" ] ] .
