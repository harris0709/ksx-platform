# IMPIX_GoodsReceiptExt — ksxgen 생성물(OBDA IMPIX_GoodsReceiptExt와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix impix: <https://ontology.impix.co.kr/ext/impix/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:IMPIX_GoodsReceiptExt a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT q.*, CASE WHEN o.\"SiteID\" IS NULL OR o.\"PlantID\" IS NULL THEN 'https://data.impix.co.kr/graph/' || q.enterpriseid ELSE 'https://data.impix.co.kr/graph/' || q.enterpriseid || '/' || o.\"SiteID\" || '/' || o.\"PlantID\" END AS kg_graph FROM (SELECT \"EnterpriseID\"::text AS enterpriseid, \"GoodsReceiptID\"::text AS goodsreceiptid, \"GoodsReceiptSequence\"::text AS goodsreceiptsequence, \"PurchaseDocumentNumber\"::text AS purchasedocumentnumber, \"PurchaseDocumentSequence\"::text AS purchasedocumentsequence, \"LotID\"::text AS lotid FROM ext.\"GoodsReceiptExt\") AS q LEFT JOIN ksx.\"GoodsReceipt\" AS o ON o.\"EnterpriseID\"::text = q.enterpriseid::text AND o.\"GoodsReceiptID\"::text = q.goodsreceiptid::text AND o.\"GoodsReceiptSequence\"::text = q.goodsreceiptsequence::text" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/GoodsReceipt/{goodsreceiptid}_{goodsreceiptsequence}" ; rr:graphMap [ rr:column "kg_graph" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseDocumentNumber ; rr:objectMap [ rr:column "purchasedocumentnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:purchaseDocumentSequence ; rr:objectMap [ rr:column "purchasedocumentsequence" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:lotID ; rr:objectMap [ rr:column "lotid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPurchaseOrderLine ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/PurchaseOrder/{purchasedocumentnumber}/line/{purchasedocumentsequence}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refLot ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Lot/{lotid}" ] ] .
