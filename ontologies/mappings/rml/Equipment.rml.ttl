# Equipment — ksxgen 생성물(OBDA Equipment와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:Equipment a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT q.*, CASE WHEN q.siteid IS NULL OR q.plantid IS NULL THEN 'https://data.impix.co.kr/graph/' || q.enterpriseid ELSE 'https://data.impix.co.kr/graph/' || q.enterpriseid || '/' || q.siteid || '/' || q.plantid END AS kg_graph FROM (SELECT \"EnterpriseID\"::text AS enterpriseid, \"SiteID\"::text AS siteid, \"PlantID\"::text AS plantid, \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"EquipmentID\"::text AS equipmentid, \"EquipmentName\" AS equipmentname, \"ParentEquipmentID\"::text AS parentequipmentid, \"EquipmentType\"::text AS equipmenttype, \"EquipmentLargeClass\"::text AS equipmentlargeclass, \"EquipmentMediumClass\"::text AS equipmentmediumclass, \"EquipmentSmallClass\"::text AS equipmentsmallclass, \"DepartmentInChargeID\"::text AS departmentinchargeid, \"PersonInChargeID\"::text AS personinchargeid, \"OperationID\"::text AS operationid, \"UseIndicator\" AS useindicator, \"DAQDevice\" AS daqdevice, \"FixedAssetID\" AS fixedassetid, \"ModelNumber\" AS modelnumber, \"SerialNumber\" AS serialnumber, \"CountryOfOrigin\" AS countryoforigin, \"Manufacturer\" AS manufacturer, \"AcquisitionDate\" AS acquisitiondate, \"Location\" AS location FROM ksx.\"Equipment\") AS q" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Equipment/{equipmentid}" ; rr:class ksx:Equipment ; rr:graphMap [ rr:column "kg_graph" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:siteID ; rr:objectMap [ rr:column "siteid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:plantID ; rr:objectMap [ rr:column "plantid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentID ; rr:objectMap [ rr:column "equipmentid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentName ; rr:objectMap [ rr:column "equipmentname" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:parentEquipmentID ; rr:objectMap [ rr:column "parentequipmentid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentType ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/EquipmentType/{equipmenttype}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentLargeClass ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/EquipmentLargeClass/{equipmentlargeclass}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentMediumClass ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/EquipmentMediumClass/{equipmentmediumclass}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:equipmentSmallClass ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/EquipmentSmallClass/{equipmentsmallclass}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:departmentInChargeID ; rr:objectMap [ rr:column "departmentinchargeid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:personInChargeID ; rr:objectMap [ rr:column "personinchargeid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:operationID ; rr:objectMap [ rr:column "operationid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:useIndicator ; rr:objectMap [ rr:column "useindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:daqDevice ; rr:objectMap [ rr:column "daqdevice" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:fixedAssetID ; rr:objectMap [ rr:column "fixedassetid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modelNumber ; rr:objectMap [ rr:column "modelnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:serialNumber ; rr:objectMap [ rr:column "serialnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:countryOfOrigin ; rr:objectMap [ rr:column "countryoforigin" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:manufacturer ; rr:objectMap [ rr:column "manufacturer" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:acquisitionDate ; rr:objectMap [ rr:column "acquisitiondate" ; rr:datatype xsd:date ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:location ; rr:objectMap [ rr:column "location" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refSite ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Site/{siteid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPlant ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Plant/{plantid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refParentEquipment ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Equipment/{parentequipmentid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refDepartmentInCharge ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Department/{departmentinchargeid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refPersonInCharge ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{personinchargeid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refOperation ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Operation/{operationid}" ] ] .
