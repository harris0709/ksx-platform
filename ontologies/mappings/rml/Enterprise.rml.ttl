# Enterprise — ksxgen 생성물(OBDA Enterprise와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:Enterprise a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT q.*, 'https://data.impix.co.kr/graph/' || q.enterpriseid AS kg_graph FROM (SELECT \"CreatorID\"::text AS creatorid, \"CreationDateTime\" AS creationdatetime, \"ModifierID\"::text AS modifierid, \"ModificationDateTime\" AS modificationdatetime, \"Note\" AS note, \"EnterpriseID\"::text AS enterpriseid, \"EnterpriseName\" AS enterprisename, \"BusinessRegistrationNumber\" AS businessregistrationnumber, \"CorporateRegistrationNumber\" AS corporateregistrationnumber, \"RepresentativeName\" AS representativename, \"ParentEnterpriseID\"::text AS parententerpriseid, \"CountryID\"::text AS countryid, \"BaseCurrencyCode\"::text AS basecurrencycode, \"DialNumber\" AS dialnumber, \"FaxNumber\" AS faxnumber, \"PostalCode\" AS postalcode, \"BaseAddress\" AS baseaddress, \"DetailAddress\" AS detailaddress, \"UseIndicator\" AS useindicator FROM ksx.\"Enterprise\") AS q" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Enterprise/{enterpriseid}" ; rr:class ksx:Enterprise ; rr:graphMap [ rr:column "kg_graph" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creatorID ; rr:objectMap [ rr:column "creatorid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:creationDateTime ; rr:objectMap [ rr:column "creationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modifierID ; rr:objectMap [ rr:column "modifierid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:modificationDateTime ; rr:objectMap [ rr:column "modificationdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:note ; rr:objectMap [ rr:column "note" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseID ; rr:objectMap [ rr:column "enterpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:enterpriseName ; rr:objectMap [ rr:column "enterprisename" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:businessRegistrationNumber ; rr:objectMap [ rr:column "businessregistrationnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:corporateRegistrationNumber ; rr:objectMap [ rr:column "corporateregistrationnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:representativeName ; rr:objectMap [ rr:column "representativename" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:parentEnterpriseID ; rr:objectMap [ rr:column "parententerpriseid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:countryID ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/CountryID/{countryid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:baseCurrencyCode ; rr:objectMap [ rr:template "https://data.impix.co.kr/codelist/CurrencyCode/{basecurrencycode}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:dialNumber ; rr:objectMap [ rr:column "dialnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:faxNumber ; rr:objectMap [ rr:column "faxnumber" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:postalCode ; rr:objectMap [ rr:column "postalcode" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:baseAddress ; rr:objectMap [ rr:column "baseaddress" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:detailAddress ; rr:objectMap [ rr:column "detailaddress" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:useIndicator ; rr:objectMap [ rr:column "useindicator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refCreator ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{creatorid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refModifier ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/Personnel/{modifierid}" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refParentEnterprise ; rr:objectMap [ rr:template "https://data.impix.co.kr/{parententerpriseid}/Enterprise/{parententerpriseid}" ] ] .
