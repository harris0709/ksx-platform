# IMPIX_AvailableInventoryExt — ksxgen 생성물(OBDA IMPIX_AvailableInventoryExt와 같은 트리플). 직접 수정 금지
@prefix ksx: <https://ontology.impix.co.kr/ksx9101/1.0/> .
@prefix impix: <https://ontology.impix.co.kr/ext/impix/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix map: <urn:ksx:map:> .

map:IMPIX_AvailableInventoryExt a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"EnterpriseID\"::text AS enterpriseid, \"AvailableInventoryID\"::text AS availableinventoryid, \"ProductionOrderID\"::text AS productionorderid, \"ProductionOrderSequence\"::text AS productionordersequence, \"AvailabilityCheckDateTime\" AS availabilitycheckdatetime, \"ShortageQuantity\" AS shortagequantity, \"MaterialRequirementQuantity\" AS materialrequirementquantity FROM ext.\"AvailableInventoryExt\"" ; rr:sqlVersion rr:SQL2008 ] ;
    rr:subjectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/AvailableInventory/{availableinventoryid}" ] ;
    rr:predicateObjectMap [ rr:predicate ksx:productionOrderID ; rr:objectMap [ rr:column "productionorderid" ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:productionOrderSequence ; rr:objectMap [ rr:column "productionordersequence" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:availabilityCheckDateTime ; rr:objectMap [ rr:column "availabilitycheckdatetime" ; rr:datatype xsd:dateTime ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:shortageQuantity ; rr:objectMap [ rr:column "shortagequantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate impix:materialRequirementQuantity ; rr:objectMap [ rr:column "materialrequirementquantity" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate ksx:refProductionOrder ; rr:objectMap [ rr:template "https://data.impix.co.kr/{enterpriseid}/ProductionOrder/{productionorderid}_{productionordersequence}" ] ] .
