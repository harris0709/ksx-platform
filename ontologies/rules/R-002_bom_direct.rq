PREFIX ksx: <https://ontology.impix.co.kr/ksx9101/1.0/>
PREFIX inf: <https://ontology.impix.co.kr/inference/>
PREFIX ksxq: <https://ontology.impix.co.kr/quality/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# R-002 자재명세서 직접 구성품(체인): 모품목 → BOM 헤더 → 라인 → 자품목. 기준일(${today})에 유효한 라인만
#   유효 기간이 없는 라인은 유효로 본다(종료일 없음 = 무기한). 자품목 참조가 비어 있는 라인(원천 고아)은 나오지 않는다.
CONSTRUCT { ?parent inf:directComponent ?child }
WHERE {
  ?bom a ksx:BOM ; ksx:refItem ?parent ; ksx:hasLine ?line .
  ?line ksx:refChildItem ?child .
  OPTIONAL { ?line ksx:validStartDateTime ?vs }
  OPTIONAL { ?line ksx:validEndDateTime ?ve }
  FILTER ((!BOUND(?vs) || ?vs <= "${today}T23:59:59"^^xsd:dateTime) && (!BOUND(?ve) || ?ve >= "${today}T00:00:00"^^xsd:dateTime))
  FILTER NOT EXISTS { ?bom ksxq:violates ?v1 }
  FILTER NOT EXISTS { ?line ksxq:violates ?v2 }
}
