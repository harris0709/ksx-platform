# A-006 자동 전이 규칙(ksxgen 생성물): 설비 상위설비식별자 참조를 끝까지 따라간다
PREFIX ksx: <https://ontology.impix.co.kr/ksx9101/1.0/>
PREFIX inf: <https://ontology.impix.co.kr/inference/>
PREFIX ksxq: <https://ontology.impix.co.kr/quality/>
CONSTRUCT { ?x inf:refParentEquipmentClosure ?y }
WHERE { ?x a ksx:Equipment ; ksx:refParentEquipment+ ?y . FILTER (?x != ?y) FILTER NOT EXISTS { ?x ksxq:violates ?v } }
