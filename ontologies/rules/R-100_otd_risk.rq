PREFIX ksx: <https://ontology.impix.co.kr/ksx9101/1.0/>
PREFIX inf: <https://ontology.impix.co.kr/inference/>
PREFIX ksxq: <https://ontology.impix.co.kr/quality/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# R-100 납기 리스크(업무 규칙)
#   IF 생산실적 불량률 > ${min_defect_rate} AND 수주라인 요청 납기 ≤ 기준일 + ${due_within_days}일(지난 납기 포함)
#   THEN 수주라인 납기 리스크 이벤트(원인 생산실적·생산지시·불량률·납기)
#   납기 상태(S7 D-3): 납기 < 기준일 → "지연", 그 밖 → "임박". 남은 기간 inf:timeToDue = 납기 − 기준일(xsd:duration, 음수 = 지난 일수)
CONSTRUCT {
  ?evt a inf:OTDRiskEvent ; inf:onSalesOrderLine ?sol ; inf:onProductionOrder ?po ; inf:causedBy ?pp ;
       inf:defectRate ?rate ; inf:dueDate ?due ; inf:dueStatus ?st ; inf:timeToDue ?ttd ; inf:baseDate ?base ;
       inf:ruleId "R-100" .
}
WHERE {
  ?pp inf:affectedSalesOrderLine ?sol ; ksx:refProductionOrder ?po ; ksx:producedQuantity ?p ; ksx:defectQuantity ?d .
  ?sol ksx:requestedDeliveryDate ?due .
  BIND (xsd:decimal(?d) / xsd:decimal(?p) AS ?rate)
  FILTER (?p > 0 && ?rate > ${min_defect_rate})
  FILTER (?due <= "${due_limit}"^^xsd:date)
  FILTER NOT EXISTS { ?pp ksxq:violates ?v }
  BIND ("${today}"^^xsd:date AS ?base)
  BIND (IF(?due < ?base, "지연", "임박") AS ?st)
  BIND (?due - ?base AS ?ttd)
  BIND (IRI(CONCAT(STR(?sol), "/risk/R-100")) AS ?evt)
}
