PREFIX ksx: <https://ontology.impix.co.kr/ksx9101/1.0/>
PREFIX inf: <https://ontology.impix.co.kr/inference/>
PREFIX ksxq: <https://ontology.impix.co.kr/quality/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# R-100 납기 리스크: 불량률 > ${min_defect_rate} 이고 납기까지 ${due_within_days}일 이내인 수주라인
CONSTRUCT {
  ?evt a inf:OTDRiskEvent ; inf:onSalesOrderLine ?sol ; inf:causedBy ?pp ;
       inf:defectRate ?rate ; inf:dueDate ?due ; inf:ruleId "R-100" .
}
WHERE {
  ?pp inf:affectedSalesOrderLine ?sol ; ksx:producedQuantity ?p ; ksx:defectQuantity ?d .
  ?sol ksx:requestedDeliveryDate ?due .
  BIND(xsd:decimal(?d) / xsd:decimal(?p) AS ?rate)
  FILTER(?p > 0 && ?rate > ${min_defect_rate})
  FILTER(?due <= "${due_limit}"^^xsd:date)
  FILTER NOT EXISTS { ?pp ksxq:violates ?v }
  BIND(IRI(CONCAT(STR(?sol), "/risk/R-100")) AS ?evt)
}
